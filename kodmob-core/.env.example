APP_NAME=Kodmob
APP_ENV=production
APP_DEBUG=false
APP_URL=https://ornek.com
APP_TIMEZONE=Europe/Istanbul
# php -r "echo 'base64:'.base64_encode(random_bytes(32));"
APP_KEY=

# Veritabanı: mysql (MariaDB dahil; Hostinger paylaşımlı hosting), pgsql (VPS / bulut) ya da sqlite
# (tek dosya; DB_DATABASE dosya yolu, ör. /home/kullanici/kodmob-core/storage/site.sqlite). Üçü de
# destekleniyor ve testleri üçünde de geçiyor. Sonradan taşımak: php artisan kodmob:db-move --to="…"
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# 64+ karakter rastgele. php -r "echo bin2hex(random_bytes(48));"
JWT_SECRET=

# Kurulum ucu (/api/v1/setup?token=...) için 24+ karakter; kurulumdan sonra boşaltın.
SETUP_TOKEN=

# Sistem Sağlığı › Bildir'in varsayılan alıcısı (teknik servis); panelde Ayarlar › Sistem sağlığı'ndan değişir.
# HEALTH_REPORT_TO=

# Yerleşim canlıdakinden farklıysa (geliştirme):
# SITE_ROOT=C:/yol/kodmob-frontend/dist
# MEDIA_ROOT=C:/yol/media
# MEDIA_URL=/media

# E-posta: Hostinger'da "sendmail" çalışır. SMTP en kolay panelden girilir (Ayarlar > E-posta;
# şifre şifreli saklanır, "Deneme gönder" ile denenir). .env'den isterseniz MAIL_MAILER=smtp ve alttakiler.
MAIL_MAILER=sendmail
MAIL_FROM_ADDRESS=info@ornek.com
# Boşsa sitenin adı (Proje Ayarları > Kimlik ya da derlemedeki site adı).
# MAIL_FROM_NAME="Şirket Adı"
# MAIL_HOST=smtp.hostinger.com
# MAIL_PORT=465
# MAIL_SCHEME=smtps
# MAIL_USERNAME=info@ornek.com
# MAIL_PASSWORD=

CACHE_STORE=file
SESSION_DRIVER=array
# Arka plan işleri (e-posta…): cron her dakika `schedule:run` çalıştırırsa kuyruktan, yoksa
# yanıttan sonra aynı istekte çalışır (App\Core\Jobs\Background). sync: hemen, isteğin içinde.
QUEUE_CONNECTION=database
LOG_CHANNEL=daily
LOG_LEVEL=warning

# Cloudflare vb. arkasında: TRUSTED_PROXIES=*
TRUSTED_PROXIES=
