{
    "name": "kodmob",
    "version": "3.0.0",
    "description": "Çatının dosyaları: kodmob:upgrade yalnızca `framework` desenlerindeki (ve `project` / `exclude` dışındaki) dosyaları yeniler. Proje, bilerek değiştirdiği bir çatı dosyasını `project` listesine ekleyebilir (güncelleme korur). Araç paketleri (kodmob-api/extensions/<anahtar>/) üçüncü sahiptir: çatı deseninde değildir, kodmob:upgrade dokunmaz; kodmob:add kurar.",
    "framework": [
        "build.mjs",
        "build.cmd",
        "kodmob-api/artisan",
        "kodmob-api/composer.json",
        "kodmob-api/composer.lock",
        "kodmob-api/phpunit.xml",
        "kodmob-api/phpstan.neon",
        "kodmob-api/phpstan-baseline.neon",
        "kodmob-api/.env.example",
        "kodmob-api/app/Core/**",
        "kodmob-api/app/Modules/**",
        "kodmob-api/app/Providers/**",
        "kodmob-api/bootstrap/app.php",
        "kodmob-api/bootstrap/providers.php",
        "kodmob-api/config/**",
        "kodmob-api/database/**",
        "kodmob-api/extensions/README.md",
        "kodmob-api/dev/**",
        "kodmob-api/public/**",
        "kodmob-api/resources/**",
        "kodmob-api/routes/**",
        "kodmob-api/tests/**",
        "tv/package.json",
        "tv/package-lock.json",
        "tv/postcss.config.js",
        "tv/vite.config.js",
        "tv/.env.example",
        "tv/e2e/**",
        "tv/public/assets/fonts/**",
        "tv/public/assets/img/flags/**",
        "tv/public/assets/img/resim-yok.svg",
        "tv/scripts/**",
        "tv/src/**",
        "tv/tests/**",
        "tv/vite/**"
    ],
    "project": [
        "kodmob-api/app/Project/**",
        "kodmob-api/config/project.php",
        "kodmob-api/routes/project.php",
        "kodmob-api/tests/Project/**",
        "tv/profile.js",
        "tv/sites/**",
        "tv/src/profiles/**"
    ],
    "exclude": [
        "**/.env",
        "**/.env.local",
        "**/*.log",
        "**/.DS_Store",
        "**/Thumbs.db",
        "**/*.kodmob-yeni"
    ]
}
