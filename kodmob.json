{
    "name": "kodmob",
    "version": "3.1.1",
    "description": "Çatının dosyaları: kodmob:upgrade yalnızca `framework` desenlerindeki (ve `project` / `exclude` dışındaki) dosyaları yeniler. Proje, bilerek değiştirdiği bir çatı dosyasını `project` listesine ekleyebilir (güncelleme korur). Araç paketleri (kodmob-core/extensions/<anahtar>/) üçüncü sahiptir: çatı deseninde değildir, kodmob:upgrade dokunmaz; kodmob:add kurar.",
    "framework": [
        "build.mjs",
        "build.cmd",
        "kodmob-core/artisan",
        "kodmob-core/composer.json",
        "kodmob-core/composer.lock",
        "kodmob-core/phpunit.xml",
        "kodmob-core/phpstan.neon",
        "kodmob-core/phpstan-baseline.neon",
        "kodmob-core/.env.example",
        "kodmob-core/app/Core/**",
        "kodmob-core/app/Modules/**",
        "kodmob-core/app/Providers/**",
        "kodmob-core/bootstrap/app.php",
        "kodmob-core/bootstrap/providers.php",
        "kodmob-core/config/**",
        "kodmob-core/database/**",
        "kodmob-core/extensions/README.md",
        "kodmob-core/dev/**",
        "kodmob-core/public/**",
        "kodmob-core/resources/**",
        "kodmob-core/routes/**",
        "kodmob-core/tests/**",
        "kodmob-frontend/package.json",
        "kodmob-frontend/package-lock.json",
        "kodmob-frontend/postcss.config.js",
        "kodmob-frontend/vite.config.js",
        "kodmob-frontend/.env.example",
        "kodmob-frontend/e2e/**",
        "kodmob-frontend/public/assets/fonts/**",
        "kodmob-frontend/public/assets/img/flags/**",
        "kodmob-frontend/public/assets/img/resim-yok.svg",
        "kodmob-frontend/scripts/**",
        "kodmob-frontend/src/**",
        "kodmob-frontend/tests/**",
        "kodmob-frontend/vite/**"
    ],
    "project": [
        "kodmob-core/app/Project/**",
        "kodmob-core/config/project.php",
        "kodmob-core/routes/project.php",
        "kodmob-core/tests/Project/**",
        "kodmob-frontend/profile.js",
        "kodmob-frontend/sites/**",
        "kodmob-frontend/src/profiles/**"
    ],
    "exclude": [
        "**/.env",
        "**/.env.local",
        "**/*.log",
        "**/.DS_Store",
        "**/Thumbs.db",
        "**/*.kodmob-yeni"
    ]
}
