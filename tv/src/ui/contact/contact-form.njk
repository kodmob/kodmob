{#
  İletişim formu (features/contact-form.js; sayfanın main.js'i `contactForm` bileşenini kaydeder). Metinler çatı
  sözlüğünde (tv/src/i18n → contactForm, client.contact); profil üstüne yazabilir. KVKK bağlantısı sitede KVKK
  sayfası yoksa gizlilik sayfasına gider.
#}
<form class="brief-card" x-data="contactForm" @submit.prevent="submit()" novalidate data-testid="contact-form">
  <div x-show="!done" class="grid gap-4 sm:grid-cols-2">
    <div class="field">
      <label class="field-label" for="contact-name">{{ t('contactForm.name') }} <span class="req">*</span></label>
      <input id="contact-name" class="input" x-model="form.name" :aria-invalid="!!errors.name" autocomplete="name" maxlength="120">
      <p class="field-error" x-show="errors.name" x-text="errors.name"></p>
    </div>
    <div class="field">
      <label class="field-label" for="contact-email">{{ t('contactForm.email') }} <span class="req">*</span></label>
      <input id="contact-email" type="email" class="input" x-model="form.email" :aria-invalid="!!errors.email" autocomplete="email" maxlength="190">
      <p class="field-error" x-show="errors.email" x-text="errors.email"></p>
    </div>
    <div class="field sm:col-span-2">
      <label class="field-label" for="contact-phone">{{ t('contactForm.phone') }} <span class="text-xs font-normal text-muted">({{ t('contactForm.optional') }})</span></label>
      <input id="contact-phone" type="tel" class="input" x-model="form.phone" autocomplete="tel" maxlength="40">
    </div>
    <div class="field sm:col-span-2">
      <label class="field-label" for="contact-message">{{ t('contactForm.message') }} <span class="req">*</span></label>
      <textarea id="contact-message" class="input" rows="6" x-model="form.message" :aria-invalid="!!errors.message" placeholder="{{ t('contactForm.messagePlaceholder') }}" maxlength="5000"></textarea>
      <p class="field-error" x-show="errors.message" x-text="errors.message"></p>
    </div>
    {# Tuzak alan: insanlar görmez; dolduran bottur. #}
    <div class="sr-only" aria-hidden="true">
      <label for="contact-website">Website</label>
      <input id="contact-website" name="website" tabindex="-1" autocomplete="off" x-model="form.website">
    </div>
    <div class="field sm:col-span-2">
      <label class="check"><input type="checkbox" x-model="form.consent" :aria-invalid="!!errors.consent"> <span>{{ t('contactForm.consent', { link: '<a href="' + (url('contactNotice') or url('kvkk')) + '" class="font-semibold text-primary" target="_blank">' + t('contactForm.consentLink') + '</a>' }) | safe }}</span></label>
      <p class="field-error" x-show="errors.consent" x-text="errors.consent"></p>
    </div>
    <div class="sm:col-span-2">
      <button type="submit" class="btn btn-primary btn-lg" :disabled="busy">
        <svg class="icon icon-sm animate-spin" aria-hidden="true" x-show="busy" x-cloak><use href="#i-loader"/></svg>
        <span x-text="busy ? $el.dataset.sending : $el.dataset.submit" data-submit="{{ t('contactForm.submit') }}" data-sending="{{ t('contactForm.sending') }}">{{ t('contactForm.submit') }}</span>
      </button>
    </div>
  </div>

  <div x-show="done" x-cloak class="flex flex-col items-center gap-4 py-8 text-center">
    <span class="icon-tile"><svg class="icon icon-lg" aria-hidden="true"><use href="#i-check-circle"/></svg></span>
    <h2 class="h3" tabindex="-1" data-done-title>{{ t('contactForm.doneTitle') }}</h2>
    <p class="text-ink-2" x-text="$el.dataset.template.replace('{email}', form.email)" data-template="{{ t('contactForm.doneText') }}"></p>
    <button type="button" class="btn btn-secondary" @click="reset()">{{ t('contactForm.doneAgain') }}</button>
  </div>
</form>
