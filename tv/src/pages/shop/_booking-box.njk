{#
  Rezervasyon kutusu (rezerve edilebilen her kayıt; kodmob-api Booking\BookingView `booking`). Kapsamda `p`: kayıt.
  Tek bileşen (features/shop.js shopBook), iki yerleşim: geniş ekranda yapışkan kart; dar ekranda altta fiyat çubuğu,
  dokununca alttan açılan sayfa. Birime göre girişler: kişi (yetişkin / çocuk / bebek), gün (alış – teslim, adet),
  sabit (kişi sayısı), gece (giriş – çıkış, oda, yetişkin / çocuk; oda tipi × pansiyon). Fiyat her değişiklikte
  sunucudan (/shop/bookings/quote).

    {% include "pages/shop/_booking-box.njk" %}
#}
{% import "macros/ui.njk" as ui %}
<div class="book" x-data="shopBook(p, '{{ url('cart') }}')" :class="sheet && 'is-open'" @keydown.escape.window="sheet = false" data-testid="book">
  {# ------------------------------------------------------------ dar ekran: alt çubuk #}
  <div class="book-bar">
    <div class="min-w-0">
      <span class="block text-xs text-muted" x-text="quote ? '{{ t('shop.booking.total') }}' : '{{ t('shop.booking.startingAt') }}'"></span>
      <strong class="text-lg text-ink" x-text="quote ? quote.totalText : b.fromText"></strong>
    </div>
    <button type="button" class="btn btn-primary" @click="sheet = true" data-testid="book-open">{{ ui.icon('calendar', 'icon icon-sm') }} {{ t('shop.booking.book') }}</button>
  </div>
  <div class="book-backdrop" @click="sheet = false" aria-hidden="true"></div>

  <aside class="book-card card" :aria-modal="sheet ? 'true' : null" :role="sheet ? 'dialog' : null" aria-label="{{ t('shop.booking.book') }}">
    <div class="book-grip" aria-hidden="true"></div>
    <button type="button" class="btn-icon book-close" @click="sheet = false" aria-label="{{ t('shop.booking.close') }}">{{ ui.icon('x', 'icon') }}</button>

    <p class="book-price">
      <span class="text-xs font-medium tracking-wide text-muted uppercase">{{ t('shop.booking.startingAt') }}</span>
      <span class="flex items-baseline gap-2"><strong class="text-2xl text-ink" x-text="b.fromText"></strong><span class="text-sm text-muted" x-text="unitLabel"></span></span>
    </p>

    {# Paketler #}
    <template x-if="b.packages.length">
      <div class="field">
        <span class="field-label">{{ t('shop.booking.packages') }}</span>
        <div class="book-packages" role="radiogroup" aria-label="{{ t('shop.booking.packages') }}">
          <template x-for="k in b.packages" :key="k.key">
            <button type="button" class="book-package" role="radio" :aria-checked="pkg === k.key" @click="pkg = k.key" :data-package="k.key">
              <span class="book-package-name" x-text="k.name"></span>
              <span class="book-package-sub" x-show="k.subtitle" x-text="k.subtitle"></span>
              <span class="book-package-price"><s x-show="k.compare > k.price" x-text="k.compareText"></s> <strong x-text="k.priceText"></strong></span>
            </button>
          </template>
        </div>
      </div>
    </template>

    {# Tarih: listeden ya da takvimden; gün biriminde alış ve teslim, gece biriminde giriş ve çıkış #}
    <div class="grid gap-3" :class="ranged && 'grid-cols-2'">
      <div class="field">
        <label class="field-label" for="book-date" x-text="unit === 'day' ? '{{ t('shop.booking.pickup') }}' : unit === 'night' ? '{{ t('shop.booking.checkIn') }}' : '{{ t('shop.booking.date') }}'"></label>
        <template x-if="dates.length">
          <select id="book-date" class="input" x-model="date" data-testid="book-date">
            <template x-for="d in dates" :key="d"><option :value="d" x-text="day(d)" :selected="d === date"></option></template>
          </select>
        </template>
        <template x-if="!dates.length">
          <input id="book-date" class="input" type="date" x-model="date" :min="first" data-testid="book-date">
        </template>
      </div>
      <template x-if="ranged">
        <div class="field">
          <label class="field-label" for="book-end" x-text="unit === 'night' ? '{{ t('shop.booking.checkOut') }}' : '{{ t('shop.booking.return') }}'"></label>
          <input id="book-end" class="input" type="date" x-model="end" :min="minEnd" data-testid="book-end">
        </div>
      </template>
    </div>
    <p class="book-stay" x-show="unit === 'night' && (nightsText || b.checkIn)" x-cloak>
      <span x-show="nightsText" x-text="nightsText" data-testid="book-nights"></span>
      <span x-show="b.checkIn">{{ t('shop.booking.checkInTime') }} <strong x-text="b.checkIn"></strong></span>
      <span x-show="b.checkOut">{{ t('shop.booking.checkOutTime') }} <strong x-text="b.checkOut"></strong></span>
    </p>

    {# Gece birimi: oda tipleri ve her birinin pansiyonları (gecelik oda fiyatı) #}
    <template x-if="unit === 'night' && hasRooms">
      <div class="field">
        <span class="field-label">{{ t('shop.booking.roomsTitle') }}</span>
        <div class="book-rooms">
          <template x-for="r in b.rooms" :key="r.key">
            <div class="book-room" :class="room === r.key && 'is-active'" :data-room="r.key">
              <p class="book-room-head"><span class="book-package-name" x-text="r.name"></span><span class="book-room-for" x-show="r.persons" x-text="roomFor(r.persons)"></span></p>
              <p class="book-package-sub" x-show="r.subtitle" x-text="r.subtitle"></p>
              <div class="book-boards" role="radiogroup" :aria-label="r.name">
                <template x-for="o in r.boards" :key="o.board">
                  <button type="button" class="book-board" role="radio" :aria-checked="room === r.key && board === o.board" @click="pick(r.key, o.board)" :data-board="o.board">
                    <span x-text="boardLabel(o.board)"></span>
                    <strong x-text="o.priceText"></strong>
                  </button>
                </template>
              </div>
            </div>
          </template>
        </div>
      </div>
    </template>

    {# Kişi / adet sayaçları #}
    <div class="book-counters">
      <template x-for="c in counters" :key="c.field">
        <div class="book-counter">
          <span class="min-w-0">
            <span class="block text-sm font-medium text-ink" x-text="c.label"></span>
            <span class="block text-xs text-muted" x-show="c.hint" x-text="c.hint"></span>
          </span>
          <div class="counter">
            <button type="button" class="counter-btn" @click="step(c.field, -1)" :disabled="$data[c.field] <= c.min" :aria-label="'{{ t('shop.booking.decrease') }}: ' + c.label">{{ ui.icon('minus', 'icon icon-sm') }}</button>
            <output class="counter-value" x-text="$data[c.field]" :data-testid="'book-' + c.field"></output>
            <button type="button" class="counter-btn" @click="step(c.field, 1)" :disabled="$data[c.field] >= c.max" :aria-label="'{{ t('shop.booking.increase') }}: ' + c.label">{{ ui.icon('plus', 'icon icon-sm') }}</button>
          </div>
        </div>
      </template>
    </div>

    {# Grup indirimi kademeleri #}
    <template x-if="b.groups.length">
      <div class="field">
        <span class="field-label">{{ t('shop.booking.groupTitle') }}</span>
        <div class="book-tiers">
          <template x-for="g in b.groups" :key="g.min">
            <span class="book-tier" :class="activeTier === g.min && 'is-active'"><strong x-text="'%' + g.percent"></strong><span x-text="tierLabel(g)"></span></span>
          </template>
        </div>
      </div>
    </template>

    <p class="text-sm text-danger" x-show="error" x-text="error" data-testid="book-error"></p>

    {# Özet: sunucunun dökümü #}
    <template x-if="quote">
      <div class="book-summary">
        <p class="flex justify-between text-ink-2" x-show="quote.base > quote.total"><span>{{ t('shop.booking.listPrice') }}</span><s x-text="quote.baseText"></s></p>
        <template x-for="r in quote.applied" :key="r.kind"><p class="flex justify-between text-success"><span x-text="rule(r)"></span></p></template>
        <p class="book-total"><span>{{ t('shop.booking.total') }}</span><span x-text="quote.totalText" data-testid="book-total"></span></p>
        <p class="text-xs text-muted" x-show="quote.remaining !== null"><span x-text="quote.remaining"></span> {{ t('shop.booking.left') }}</p>
      </div>
    </template>

    <button type="button" class="btn btn-primary btn-lg w-full justify-center" @click="book()" :disabled="busy || !quote" data-testid="book-submit">{{ ui.icon('calendar', 'icon icon-sm') }} {{ t('shop.booking.book') }}</button>
  </aside>
</div>
