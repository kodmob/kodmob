{#
  Sayfa düzenleyici. Mantık panel/builder.js (+ builder/stage.js, drag.js, model.js); uçlar kodmob-api
  Site\Http\LayoutsController. Tam ekran: panelin menüsü ve üst barı düzenleyicinin altında kalır.

  `control(def, get, put, pick)`: alan ya da satır sütunu için tek denetim. `def` alan tanımının, `get` değerin JS
  ifadesi; `put` değeri yazan işlev ifadesi (`(v) => set(f, v)`), `pick` görsel seçen ifade.
#}
{% macro control(def, get, put, pick) %}
<template x-if="{{ def }}.type === 'text'">
  <input class="input" :value="{{ get }}" @input="({{ put }})($event.target.value)" :maxlength="{{ def }}.max || null" autocomplete="off">
</template>
<template x-if="{{ def }}.type === 'textarea'">
  <textarea class="input bd-textarea" rows="3" :value="{{ get }}" @input="({{ put }})($event.target.value)" :maxlength="{{ def }}.max || null"></textarea>
</template>
<template x-if="{{ def }}.type === 'int'">
  <input class="input" type="number" step="1" :min="{{ def }}.min ?? null" :max="{{ def }}.max ?? null" :value="{{ get }}" @input="({{ put }})(Number($event.target.value) || 0)">
</template>
<template x-if="{{ def }}.type === 'bool'">
  <label class="pn-switch">
    <input type="checkbox" class="peer sr-only" :checked="!!({{ get }})" @change="({{ put }})($event.target.checked)">
    <span class="pn-switch-track" aria-hidden="true"></span>
    <span class="text-sm text-ink-2" x-text="({{ get }}) ? 'Açık' : 'Kapalı'"></span>
  </label>
</template>
<template x-if="{{ def }}.type === 'select'">
  <div>
    <template x-if="options({{ def }}).length <= 4">
      <div class="segmented bd-segmented" role="group">
        <template x-for="o in options({{ def }})" :key="o.value">
          <button type="button" :aria-pressed="String({{ get }}) === o.value" @click="({{ put }})(o.value)" x-text="o.label"></button>
        </template>
      </div>
    </template>
    <template x-if="options({{ def }}).length > 4">
      <select class="input" @change="({{ put }})($event.target.value)">
        <template x-for="o in options({{ def }})" :key="o.value"><option :value="o.value" :selected="String({{ get }}) === o.value" x-text="o.label"></option></template>
      </select>
    </template>
  </div>
</template>
<template x-if="{{ def }}.type === 'icon'">
  <div class="relative" x-data="{ open: false }" @click.outside="open = false" @keydown.escape.stop="open = false">
    <button type="button" class="bd-iconpick" @click="open = !open" :aria-expanded="open">
      <span class="icon-tile icon-tile-sm"><svg class="icon" aria-hidden="true"><use :href="'#i-' + ({{ get }})"/></svg></span>
      <span class="flex-1 truncate text-left text-sm" x-text="{{ get }}"></span>
      <svg class="icon icon-sm text-muted" aria-hidden="true"><use href="#i-chevron-down"/></svg>
    </button>
    <div class="bd-pop bd-icons" x-show="open" x-cloak x-transition.opacity.duration.100ms>
      <template x-for="name in icons" :key="name">
        <button type="button" :class="name === ({{ get }}) && 'is-active'" @click="({{ put }})(name); open = false" :title="name" :aria-label="name"><svg class="icon" aria-hidden="true"><use :href="'#i-' + name"/></svg></button>
      </template>
    </div>
  </div>
</template>
<template x-if="{{ def }}.type === 'link'">
  <div class="bd-link">
    <select class="input" @change="$event.target.value === '__url' ? ({{ put }})('https://') : ({{ put }})($event.target.value)">
      <option value="" :selected="!({{ get }})">— Bağlantı yok —</option>
      <template x-for="p in linkPages" :key="p.value"><option :value="p.value" :selected="({{ get }}) === p.value" x-text="'Sayfa: ' + p.label"></option></template>
      <option value="__url" :selected="linkKind({{ get }}) === 'url'">Adres yaz…</option>
    </select>
    <input class="input" x-show="linkKind({{ get }}) === 'url'" :value="{{ get }}" @input="({{ put }})($event.target.value)" placeholder="https://… ya da /yol/" autocomplete="off" spellcheck="false">
  </div>
</template>
<template x-if="{{ def }}.type === 'image'">
  <div class="bd-image">
    <template x-if="imageSrc({{ get }})"><img :src="imageSrc({{ get }})" alt=""></template>
    <template x-if="!imageSrc({{ get }})"><span class="bd-image-empty"><svg class="icon" aria-hidden="true"><use href="#i-image"/></svg> <span x-text="({{ get }}) ? 'Görsel seçili' : 'Görsel yok'"></span></span></template>
    <div class="flex gap-1.5">
      <button type="button" class="btn btn-secondary btn-sm" @click="{{ pick }}">Seç</button>
      <button type="button" class="btn btn-ghost btn-sm" x-show="{{ get }}" @click="({{ put }})(0)">Kaldır</button>
    </div>
  </div>
</template>
{% endmacro %}

<div class="bd" x-data="kmBuilder()" data-testid="builder" :class="{ 'is-dragging': dragging, 'is-interact': mode === 'interact' }">

  {# ============================================================ üst çubuk #}
  <header class="bd-top">
    <button type="button" class="btn-icon" @click="backToPanel()" title="Panele dön" aria-label="Panele dön"><svg class="icon" aria-hidden="true"><use href="#i-chevron-left"/></svg></button>
    <span class="bd-brand"><span class="bd-logo"><svg class="icon icon-sm" aria-hidden="true"><use href="#i-pen-tool"/></svg></span><span class="hidden xl:inline">Sayfa düzenleyici</span></span>

    <div class="relative" @click.outside="pagePicker = false">
      <button type="button" class="bd-page" @click="pagePicker = !pagePicker; $nextTick(() => $refs.pageQuery?.focus())" :aria-expanded="pagePicker" data-testid="builder-page">
        <svg class="icon icon-sm text-muted" aria-hidden="true"><use href="#i-book"/></svg>
        <span class="truncate" x-text="page ? page.label : 'Sayfa'"></span>
        <span class="bd-dot" x-show="page && pageHasDraft(page)" title="Yayınlanmamış değişiklik"></span>
        <svg class="icon icon-sm text-muted" aria-hidden="true"><use href="#i-chevron-down"/></svg>
      </button>
      <div class="bd-pop bd-pages" x-show="pagePicker" x-cloak x-transition.opacity.duration.100ms>
        <input class="input" x-ref="pageQuery" x-model="pageQuery" placeholder="Sayfa ara…" aria-label="Sayfa ara" @keydown.enter="filteredPages[0] && choosePage(filteredPages[0].name)">
        <div class="bd-pages-list">
          <p class="bd-pages-title" x-show="blockPages.length || canCreatePages">Sitenin sayfaları</p>
          <template x-for="p in sitePages" :key="p.name">
            <button type="button" class="bd-page-item" :class="p.name === pageName && 'is-active'" @click="choosePage(p.name)" :data-page="p.name">
              <span class="min-w-0 flex-1"><span class="block truncate font-medium" x-text="p.label"></span><small class="block truncate text-muted" x-text="p.dynamic ? 'Kayıt sayfası şablonu (bütün kayıtlarda)' : (p.paths[locale] || p.paths[defaultLocale] || '')"></small></span>
              <span class="bd-dot" x-show="pageHasDraft(p)"></span>
            </button>
          </template>
          <template x-if="canCreatePages">
            <div>
              <p class="bd-pages-title">Blok sayfaları</p>
              <template x-for="p in blockPages" :key="p.name">
                <button type="button" class="bd-page-item" :class="p.name === pageName && 'is-active'" @click="choosePage(p.name)" :data-page="p.name">
                  <span class="min-w-0 flex-1"><span class="block truncate font-medium" x-text="p.label"></span><small class="block truncate text-muted" x-text="p.paths[locale] || p.paths[defaultLocale] || '—'"></small></span>
                  <span class="badge badge-neutral" x-show="p.record.status === 'draft'">Taslak</span>
                  <span class="bd-dot" x-show="pageHasDraft(p)"></span>
                </button>
              </template>
              <p class="px-2 py-1 text-xs text-muted" x-show="!blockPages.length && !pageQuery">Kampanya, etkinlik, hakkımızda… Bloklarla kendi sayfanızı kurun.</p>
            </div>
          </template>
        </div>
        <button type="button" class="bd-page-new" x-show="canCreatePages" @click="openNewPage()" data-testid="builder-new-page">
          <svg class="icon icon-sm" aria-hidden="true"><use href="#i-plus"/></svg> Yeni sayfa<span class="truncate text-muted" x-show="pageQuery.trim()" x-text="': ' + pageQuery.trim()"></span>
        </button>
      </div>
    </div>

    <div class="segmented bd-segmented hidden md:inline-flex" role="group" aria-label="Dil" x-show="locales.length > 1">
      <template x-for="code in locales" :key="code">
        <button type="button" :aria-pressed="code === locale" @click="setLocale(code)" x-text="code.toUpperCase()"></button>
      </template>
    </div>

    <div class="flex-1"></div>

    <div class="segmented bd-segmented hidden lg:inline-flex" role="group" aria-label="Cihaz">
      <template x-for="d in devices" :key="d.key">
        <button type="button" :aria-pressed="device === d.key" @click="device = d.key" :title="d.label" :aria-label="d.label"><svg class="icon icon-sm" :class="d.key === 'tablet' && 'bd-tablet'" aria-hidden="true"><use :href="'#i-' + d.icon"/></svg></button>
      </template>
    </div>
    <div class="segmented bd-segmented hidden sm:inline-flex" role="group" aria-label="Kip">
      <button type="button" :aria-pressed="mode === 'edit'" @click="setMode('edit')" title="Düzenle: tıkla seç, çift tıkla yaz">Düzenle</button>
      <button type="button" :aria-pressed="mode === 'interact'" @click="setMode('interact')" title="Gezin: site gibi çalışır, bağlantılar açılır" data-testid="builder-interact">Gezin</button>
    </div>
    <div class="hidden items-center sm:flex">
      <button type="button" class="btn-icon" @click="undo()" :disabled="!canUndo" title="Geri al (Ctrl+Z)" aria-label="Geri al"><svg class="icon icon-sm" aria-hidden="true"><use href="#i-rotate-ccw"/></svg></button>
      <button type="button" class="btn-icon" @click="redo()" :disabled="!canRedo" title="Yinele (Ctrl+Y)" aria-label="Yinele"><svg class="icon icon-sm -scale-x-100" aria-hidden="true"><use href="#i-rotate-ccw"/></svg></button>
    </div>
    <span class="bd-status hidden md:inline-flex" :class="publishCount ? 'is-draft' : 'is-live'" aria-live="polite" data-testid="builder-status"><span class="bd-status-dot"></span><span x-text="status"></span></span>
    <button type="button" class="btn btn-secondary btn-sm hidden md:inline-flex" x-show="aiOn" @click="ai.suggest = true" title="Jarvis bu sayfaya bölüm önersin"><svg class="icon icon-sm text-primary" aria-hidden="true"><use href="#i-sparkles"/></svg> Jarvis</button>
    <a class="btn-icon" :href="pageSettingsUrl()" x-show="page?.record" title="Sayfa ayarları: başlık, adres, açıklama, diller" aria-label="Sayfa ayarları" data-testid="builder-page-settings"><svg class="icon icon-sm" aria-hidden="true"><use href="#i-sliders"/></svg></a>
    <a class="btn-icon" :href="siteUrl()" target="_blank" rel="noopener" title="Yayındaki sayfayı yeni sekmede aç" aria-label="Sitede aç"><svg class="icon icon-sm" aria-hidden="true"><use href="#i-external"/></svg></a>
    <div class="bd-publish relative" @click.outside="menu = false">
      <button type="button" class="btn btn-primary btn-sm" @click="publish()" :disabled="publishing || !publishCount" data-testid="builder-publish">
        <svg class="icon icon-sm" :class="publishing && 'animate-spin'" aria-hidden="true"><use :href="publishing ? '#i-loader' : '#i-send'"/></svg>
        <span>Yayınla</span><span class="bd-count" x-show="publishCount" x-text="publishCount"></span>
      </button>
      <button type="button" class="btn btn-primary btn-sm bd-more" @click="menu = !menu" :aria-expanded="menu" aria-label="Diğer"><svg class="icon icon-sm" aria-hidden="true"><use href="#i-chevron-down"/></svg></button>
      <div class="bd-pop bd-menu" x-show="menu" x-cloak x-transition.opacity.duration.100ms role="menu">
        <button type="button" class="menu-item text-danger" @click="discard()" :disabled="!draftZones.length" role="menuitem"><svg class="icon icon-sm" aria-hidden="true"><use href="#i-trash"/></svg> Yayınlanmamış değişiklikleri at</button>
        <p class="bd-menu-title">Yayın geçmişi</p>
        <template x-for="z in pageZones" :key="z">
          <button type="button" class="menu-item" @click="openRevisions(z)" role="menuitem"><svg class="icon icon-sm" aria-hidden="true"><use href="#i-history"/></svg> <span x-text="zoneLabel(z)"></span></button>
        </template>
      </div>
    </div>
  </header>

  <template x-if="!loading && !built">
    <div class="bd-note"><p>Sitenin derlemesinde blok kitaplığı yok (km-blocks.json). Ön yüzü bu sürümle derleyip yükleyin.</p></div>
  </template>

  <div class="bd-body">
    {# ============================================================ sol: katmanlar ve kitaplık #}
    <aside class="bd-left" :class="leftOpen && 'is-open'" aria-label="Bölümler ve blok kitaplığı">
      <div class="bd-tabs" role="tablist">
        <button type="button" role="tab" :aria-selected="tab === 'layers'" @click="tab = 'layers'" data-testid="builder-tab-layers"><svg class="icon icon-sm" aria-hidden="true"><use href="#i-layers"/></svg> Bölümler</button>
        <button type="button" role="tab" :aria-selected="tab === 'add'" @click="tab = 'add'; $nextTick(() => $refs.libraryQuery?.focus())" data-testid="builder-tab-add"><svg class="icon icon-sm" aria-hidden="true"><use href="#i-plus"/></svg> Ekle</button>
      </div>

      <div class="bd-scroll" x-show="tab === 'layers'">
        <template x-for="z in pageZones" :key="z">
          <section class="bd-zone" :data-zone="z">
            <header class="bd-zone-head">
              <span class="min-w-0 flex-1 truncate" x-text="zoneLabel(z)"></span>
              <span class="bd-badge" x-show="isGlobal(z)" title="Bu bölge bütün sayfalarda görünür">Her sayfada</span>
              <span class="bd-dot" x-show="zones[z]?.draft || pending[z]" title="Yayınlanmamış değişiklik"></span>
              <button type="button" class="btn-icon bd-mini" @click="openInsert(z, blocksOf(z).length)" title="Bu bölgeye blok ekle" aria-label="Blok ekle"><svg class="icon icon-sm" aria-hidden="true"><use href="#i-plus"/></svg></button>
            </header>
            <ol class="bd-layers" :data-layer-zone="z">
              <template x-for="(b, i) in blocksOf(z)" :key="b.id">
                <li class="bd-layer" :data-layer-id="b.id" :class="{ 'is-selected': isSelected(z, b.id), 'is-hidden': b.hidden, 'drop-before': layerDrop && layerDrop.zone === z && layerDrop.index === i }"
                  @pointerdown="drag($event, { from: { zone: z, id: b.id } })" @mouseenter="hover = { zone: z, id: b.id }; overlay()" @mouseleave="hover = null; overlay()"
                  tabindex="0" @keydown.enter="select({ zone: z, id: b.id })" :aria-label="label(b)" data-testid="builder-layer">
                  <span class="bd-grip" aria-hidden="true"><svg class="icon icon-sm" aria-hidden="true"><use href="#i-grip"/></svg></span>
                  <span class="bd-layer-icon"><svg class="icon icon-sm" aria-hidden="true"><use :href="'#i-' + (def(b.type)?.icon || 'layers')"/></svg></span>
                  <span class="bd-layer-text"><strong x-text="label(b)"></strong><small x-text="summary(b)"></small></span>
                  <button type="button" class="btn-icon bd-mini" @pointerdown.stop @click.stop="toggleHidden({ zone: z, id: b.id })" :title="b.hidden ? 'Göster' : 'Gizle'" :aria-label="b.hidden ? 'Göster' : 'Gizle'"><svg class="icon icon-sm" aria-hidden="true"><use :href="b.hidden ? '#i-eye-off' : '#i-eye'"/></svg></button>
                </li>
              </template>
              <li class="bd-layer-end" :class="layerDrop && layerDrop.zone === z && layerDrop.index === blocksOf(z).length && 'drop-before'">
                <button type="button" class="bd-add" @click="openInsert(z, blocksOf(z).length)"><svg class="icon icon-sm" aria-hidden="true"><use href="#i-plus"/></svg> <span x-text="blocksOf(z).length ? 'Blok ekle' : 'Boş · blok ekleyin ya da sürükleyin'"></span></button>
              </li>
            </ol>
          </section>
        </template>
        <p class="bd-hint">Sürükleyerek sıralayın; sayfada yazıya çift tıklayıp yerinde yazın. <kbd>Ctrl</kbd>+<kbd>Z</kbd> geri alır.</p>
      </div>

      <div class="bd-scroll" x-show="tab === 'add'">
        <div class="bd-insert-note" x-show="insertAt" x-cloak>
          <svg class="icon icon-sm" aria-hidden="true"><use href="#i-arrow-right"/></svg>
          <span class="min-w-0 flex-1 truncate" x-text="insertAt ? 'Eklenecek yer: ' + zoneLabel(insertAt.zone) : ''"></span>
          <button type="button" class="text-xs font-semibold text-primary" @click="insertAt = null; overlay()">Vazgeç</button>
        </div>
        <label class="bd-search">
          <svg class="icon icon-sm" aria-hidden="true"><use href="#i-search"/></svg>
          <input x-ref="libraryQuery" x-model="query" placeholder="Blok ara…" aria-label="Blok ara" data-testid="builder-library-search">
        </label>
        <div class="bd-cats" role="group" aria-label="Kategori">
          <template x-for="c in libraryCategories" :key="c.key">
            <button type="button" class="chip" :aria-pressed="category === c.key" @click="category = c.key" x-text="c.label"></button>
          </template>
        </div>
        <div class="bd-cards">
          <template x-for="b in library" :key="b.type">
            <button type="button" class="bd-card" @pointerdown="drag($event, { type: b.type })" :data-block="b.type" :title="b.description" data-testid="builder-card">
              <span class="bd-card-media" :class="'cat-' + b.category">
                <template x-if="b.preview"><img :src="b.preview" alt="" draggable="false"></template>
                <template x-if="!b.preview"><span class="bd-card-icon"><svg class="icon icon-lg" aria-hidden="true"><use :href="'#i-' + b.icon"/></svg></span></template>
                <span class="bd-card-badge" x-show="!b.inLibrary">Keşfet</span>
              </span>
              <span class="bd-card-label" x-text="b.label"></span>
              <span class="bd-card-desc" x-text="b.description"></span>
            </button>
          </template>
        </div>
        <p class="bd-hint" x-show="!library.length">Bu aramada blok yok.</p>
        <p class="bd-hint">Kartı sayfada istediğiniz yere sürükleyin ya da tıklayın. "Keşfet" işaretliler ilk kullanımda kitaplığa eklenir.</p>
      </div>
    </aside>

    {# ============================================================ sahne #}
    <main class="bd-stage" x-ref="stage" aria-label="Sayfa önizlemesi">
      <div class="bd-viewport" x-ref="viewport" :class="'is-' + device">
        <div class="bd-device" :style="deviceStyle">
          <iframe x-ref="frame" class="bd-frame" title="Sayfa önizlemesi" data-testid="builder-frame"></iframe>
        </div>
      </div>

      <div class="bd-overlay" x-show="mode === 'edit' && frameReady">
        <template x-for="z in boxes.zones" :key="z.key">
          <div class="bd-zone-box" :class="{ 'is-empty': z.empty, 'is-drag': dragging }" :style="box(z.rect)">
            <span class="bd-zone-tag" x-text="z.label"></span>
            <button type="button" class="bd-zone-add" x-show="z.empty && !dragging" @click="openInsert(z.key, 0)"><svg class="icon icon-sm" aria-hidden="true"><use href="#i-plus"/></svg> Blok ekle</button>
          </div>
        </template>
        <div class="bd-hover-box" :style="box(boxes.hover)"><span class="bd-box-tag" x-text="hoverLabel()"></span></div>
        <div class="bd-select-box" :style="box(boxes.selected)">
          <span class="bd-box-tag is-selected" x-text="selectedBlock ? label(selectedBlock) : ''"></span>
          <button type="button" class="bd-plus is-top" @click="insertNear(0)" title="Üstüne blok ekle" aria-label="Üstüne blok ekle"><svg class="icon icon-sm" aria-hidden="true"><use href="#i-plus"/></svg></button>
          <button type="button" class="bd-plus is-bottom" @click="insertNear(1)" title="Altına blok ekle" aria-label="Altına blok ekle"><svg class="icon icon-sm" aria-hidden="true"><use href="#i-plus"/></svg></button>
        </div>
        <div class="bd-toolbar" :style="toolbarStyle" data-testid="builder-toolbar">
          <button type="button" class="bd-tool is-grip" @pointerdown="drag($event, { from: selected })" title="Sürükleyerek taşı" aria-label="Taşı"><svg class="icon icon-sm" aria-hidden="true"><use href="#i-grip"/></svg></button>
          <button type="button" class="bd-tool" @click="move(-1)" title="Yukarı (Alt+↑)" aria-label="Yukarı"><svg class="icon icon-sm -rotate-90" aria-hidden="true"><use href="#i-chevron-right"/></svg></button>
          <button type="button" class="bd-tool" @click="move(1)" title="Aşağı (Alt+↓)" aria-label="Aşağı"><svg class="icon icon-sm rotate-90" aria-hidden="true"><use href="#i-chevron-right"/></svg></button>
          <button type="button" class="bd-tool" @click="duplicate()" title="Çoğalt (Ctrl+D)" aria-label="Çoğalt"><svg class="icon icon-sm" aria-hidden="true"><use href="#i-copy"/></svg></button>
          <button type="button" class="bd-tool" @click="toggleHidden()" :title="selectedBlock?.hidden ? 'Göster' : 'Gizle'" aria-label="Gizle ya da göster"><svg class="icon icon-sm" aria-hidden="true"><use :href="selectedBlock?.hidden ? '#i-eye-off' : '#i-eye'"/></svg></button>
          <button type="button" class="bd-tool is-danger" @click="remove()" title="Kaldır (Delete)" aria-label="Kaldır" data-testid="builder-remove"><svg class="icon icon-sm" aria-hidden="true"><use href="#i-trash"/></svg></button>
        </div>
        <div class="bd-line" :style="line(boxes.drop)"></div>
        <div class="bd-line is-insert" :style="line(boxes.insert)"><span>Buraya eklenecek</span></div>
      </div>

      <div class="bd-catcher"></div>
      <div class="bd-loading" x-show="!frameReady && !frameNote" x-cloak><svg class="icon animate-spin" aria-hidden="true"><use href="#i-loader"/></svg><span>Sayfa açılıyor…</span></div>
      <div class="bd-note" x-show="frameNote" x-cloak><svg class="icon icon-lg text-muted" aria-hidden="true"><use href="#i-info"/></svg><p x-text="frameNote"></p></div>

      {# Dar ekran: paneller çekmece #}
      <div class="bd-fabs">
        <button type="button" class="btn btn-secondary btn-sm" @click="leftOpen = !leftOpen; rightOpen = false"><svg class="icon icon-sm" aria-hidden="true"><use href="#i-layers"/></svg> Bölümler</button>
        <button type="button" class="btn btn-secondary btn-sm" x-show="selectedBlock" @click="rightOpen = !rightOpen; leftOpen = false"><svg class="icon icon-sm" aria-hidden="true"><use href="#i-sliders"/></svg> Ayarlar</button>
      </div>
    </main>

    {# ============================================================ sağ: seçili bloğun alanları #}
    <aside class="bd-right" :class="rightOpen && 'is-open'" aria-label="Blok ayarları">
      <template x-if="!selectedBlock">
        <div class="bd-empty">
          <span class="bd-empty-art" aria-hidden="true"><svg class="icon icon-lg" aria-hidden="true"><use href="#i-pen-tool"/></svg></span>
          <p class="font-semibold text-ink">Bir bölüm seçin</p>
          <p class="text-sm text-ink-2">Sayfada bir bölüme tıklayın: ayarları burada açılır. Yazıya çift tıklayıp doğrudan yazabilirsiniz.</p>
          <ul class="bd-tips">
            <li><kbd>Ctrl</kbd>+<kbd>D</kbd> çoğalt · <kbd>Delete</kbd> kaldır</li>
            <li><kbd>Alt</kbd>+<kbd>↑</kbd>/<kbd>↓</kbd> taşı · <kbd>Ctrl</kbd>+<kbd>C</kbd>/<kbd>V</kbd> sayfalar arası kopyala</li>
            <li>Değişiklikler taslağa kendiliğinden kaydedilir; ziyaretçiler <strong>Yayınla</strong>'dan sonra görür.</li>
          </ul>
          <button type="button" class="btn btn-secondary btn-sm" x-show="aiOn" @click="ai.suggest = true"><svg class="icon icon-sm text-primary" aria-hidden="true"><use href="#i-sparkles"/></svg> Jarvis bu sayfaya bölüm önersin</button>
        </div>
      </template>

      <template x-if="selectedBlock">
        <div class="bd-inspector" data-testid="builder-inspector">
          <header class="bd-inspector-head">
            <span class="bd-layer-icon is-lg"><svg class="icon" aria-hidden="true"><use :href="'#i-' + (selectedDef?.icon || 'layers')"/></svg></span>
            <span class="min-w-0 flex-1">
              <span class="block font-semibold text-ink" x-text="selectedDef?.label"></span>
              <span class="block truncate text-xs text-muted" x-text="selected ? zoneLabel(selected.zone) : ''"></span>
            </span>
            <button type="button" class="btn-icon bd-mini" @click="copy()" title="Kopyala (Ctrl+C)" aria-label="Kopyala"><svg class="icon icon-sm" aria-hidden="true"><use href="#i-clipboard"/></svg></button>
            <button type="button" class="btn-icon bd-mini" @click="select(null)" title="Kapat (Esc)" aria-label="Kapat"><svg class="icon icon-sm" aria-hidden="true"><use href="#i-x"/></svg></button>
          </header>
          <p class="bd-locale-note" x-show="locales.length > 1">
            Metinler <strong x-text="locale.toUpperCase()"></strong> için; <span class="bd-shared">tüm diller</span> işaretli alanlar her dilde aynı.
          </p>

          <div class="bd-fields">
            <template x-for="f in fields" :key="(selected?.zone || '') + (selected?.id || '') + locale + rev + f.name">
              <div class="bd-field" :data-field="f.name">
                <div class="bd-field-label">
                  <span x-text="f.label"></span>
                  <span class="bd-shared" x-show="!f.localized && locales.length > 1" title="Bütün dillerde aynı">tüm diller</span>
                  <span class="bd-badge is-warn" x-show="untranslated(f)" title="Bu dilde yazılmadı; varsayılan dilin metni görünüyor">çevrilmedi</span>
                </div>
                <template x-if="f.type === 'html'">
                  <div class="rte" x-data="kmRichText(() => value(f), (v) => set(f, v), () => locale)">
                    <div class="rte-toolbar" role="toolbar" aria-label="Biçimlendirme">
                      <button type="button" class="rte-btn" :class="is('heading', { level: 3 }) && 'is-active'" @click="run('toggleHeading', { level: 3 })" title="Alt başlık">H3</button>
                      <button type="button" class="rte-btn font-bold" :class="is('bold') && 'is-active'" @click="run('toggleBold')" title="Kalın">B</button>
                      <button type="button" class="rte-btn italic" :class="is('italic') && 'is-active'" @click="run('toggleItalic')" title="İtalik">I</button>
                      <button type="button" class="rte-btn" :class="is('link') && 'is-active'" @click="link()" title="Bağlantı"><svg class="icon icon-sm" aria-hidden="true"><use href="#i-link"/></svg></button>
                      <button type="button" class="rte-btn" :class="is('bulletList') && 'is-active'" @click="run('toggleBulletList')" title="Madde listesi"><svg class="icon icon-sm" aria-hidden="true"><use href="#i-list"/></svg></button>
                      <button type="button" class="rte-btn" :class="is('blockquote') && 'is-active'" @click="run('toggleBlockquote')" title="Alıntı"><svg class="icon icon-sm" aria-hidden="true"><use href="#i-quote"/></svg></button>
                    </div>
                    <div x-ref="area" class="rte-area bd-rte"></div>
                  </div>
                </template>
                <template x-if="f.type !== 'rows' && f.type !== 'html'">
                  <div>{{ control('f', 'value(f)', '(v) => set(f, v)', 'pickImage(f)') }}</div>
                </template>
                <template x-if="f.type === 'rows'">
                  <div class="bd-rows">
                    <template x-for="(row, i) in rows(f)" :key="i">
                      <div class="bd-row" x-data="{ open: false }" :class="open && 'is-open'">
                        <div class="bd-row-head">
                          <button type="button" class="bd-row-toggle" @click="open = !open" :aria-expanded="open">
                            <span class="bd-row-no" x-text="i + 1"></span>
                            <span class="min-w-0 flex-1 truncate text-left" x-text="Object.values(row).find((v) => typeof v === 'string' && v && !v.startsWith('route:')) || 'Boş satır'"></span>
                            <svg class="icon icon-sm text-muted transition-transform" :class="open && 'rotate-180'" aria-hidden="true"><use href="#i-chevron-down"/></svg>
                          </button>
                          <button type="button" class="btn-icon bd-mini" @click="moveRow(f, i, -1)" :disabled="i === 0" aria-label="Yukarı"><svg class="icon icon-sm -rotate-90" aria-hidden="true"><use href="#i-chevron-right"/></svg></button>
                          <button type="button" class="btn-icon bd-mini" @click="moveRow(f, i, 1)" :disabled="i === rows(f).length - 1" aria-label="Aşağı"><svg class="icon icon-sm rotate-90" aria-hidden="true"><use href="#i-chevron-right"/></svg></button>
                          <button type="button" class="btn-icon bd-mini text-danger" @click="removeRow(f, i)" aria-label="Satırı sil"><svg class="icon icon-sm" aria-hidden="true"><use href="#i-trash"/></svg></button>
                        </div>
                        <div class="bd-row-body" x-show="open" x-collapse>
                          <template x-for="c in f.columns" :key="c.name">
                            <div class="bd-cell">
                              <span class="bd-cell-label" x-text="c.label"></span>
                              {{ control('c', 'row[c.name]', '(v) => setCell(f, i, c, v)', 'pickImage(f, i, c)') }}
                            </div>
                          </template>
                        </div>
                      </div>
                    </template>
                    <button type="button" class="bd-add" @click="addRow(f)" :disabled="f.max && rows(f).length >= f.max"><svg class="icon icon-sm" aria-hidden="true"><use href="#i-plus"/></svg> Satır ekle</button>
                  </div>
                </template>
                <p class="field-help" x-show="f.help" x-text="f.help"></p>
              </div>
            </template>
          </div>

          <section class="bd-ai" x-show="aiOn">
            <p class="bd-ai-title"><svg class="icon icon-sm" aria-hidden="true"><use href="#i-sparkles"/></svg> Jarvis ile yaz</p>
            <div class="bd-ai-chips">
              <template x-for="p in prompts" :key="p">
                <button type="button" class="chip" @click="assist(p)" :disabled="ai.busy" x-text="p"></button>
              </template>
            </div>
            <textarea class="input bd-textarea" rows="2" x-model="ai.prompt" placeholder="İsteğinizi yazın: ör. “Kapadokya'da balon turu yapan bir acente için yaz”" @keydown.ctrl.enter="assist()"></textarea>
            <div class="flex flex-wrap gap-2">
              <button type="button" class="btn btn-primary btn-sm" @click="assist()" :disabled="ai.busy || !ai.prompt.trim()" data-testid="builder-assist">
                <svg class="icon icon-sm" :class="ai.busy && 'animate-spin'" aria-hidden="true"><use :href="ai.busy ? '#i-loader' : '#i-sparkles'"/></svg> Yaz
              </button>
              <button type="button" class="btn btn-secondary btn-sm" x-show="locales.length > 1" @click="translate()" :disabled="ai.translating">
                <svg class="icon icon-sm" :class="ai.translating && 'animate-spin'" aria-hidden="true"><use :href="ai.translating ? '#i-loader' : '#i-globe'"/></svg> Diğer dillere çevir
              </button>
            </div>
            <p class="text-xs text-muted">Yalnızca bu bölümün metinleri gönderilir. Sonuç taslaktır; Ctrl+Z geri alır.</p>
          </section>
        </div>
      </template>
    </aside>
  </div>

  {# ============================================================ pencereler #}
  <div class="bd-modal" x-show="ai.suggest" x-cloak @keydown.escape.window="ai.suggest = false" x-transition.opacity>
    <div class="bd-dialog" role="dialog" aria-modal="true" aria-labelledby="bd-suggest-title" @click.outside="ai.suggest = false">
      <p class="bd-dialog-art" aria-hidden="true"><svg class="icon icon-lg" aria-hidden="true"><use href="#i-sparkles"/></svg></p>
      <h3 id="bd-suggest-title" class="h3">Jarvis bu sayfaya bölüm önersin</h3>
      <p class="text-sm text-ink-2">Sayfanın neyi anlatmasını istediğinizi yazın. Jarvis kitaplıktaki bloklardan sıralı bölümler seçip metinlerini <strong x-text="locale.toUpperCase()"></strong> yazar ve taslağa ekler.</p>
      <textarea class="input" rows="4" x-model="ai.brief" placeholder="ör. Kapadokya'da balon turu yapan bir acente; güven, fiyatlar ve rezervasyon öne çıksın."></textarea>
      <div class="flex justify-end gap-2">
        <button type="button" class="btn btn-ghost btn-sm" @click="ai.suggest = false">Vazgeç</button>
        <button type="button" class="btn btn-primary btn-sm" @click="suggest()" :disabled="ai.suggesting">
          <svg class="icon icon-sm" :class="ai.suggesting && 'animate-spin'" aria-hidden="true"><use :href="ai.suggesting ? '#i-loader' : '#i-sparkles'"/></svg> <span x-text="ai.suggesting ? 'Jarvis yazıyor…' : 'Öner ve ekle'"></span>
        </button>
      </div>
    </div>
  </div>

  <div class="bd-modal" x-show="newPage.open" x-cloak @keydown.escape.window="newPage.open = false" x-transition.opacity>
    <form class="bd-dialog" role="dialog" aria-modal="true" aria-labelledby="bd-page-title" @click.outside="newPage.open = false" @submit.prevent="createPage()" data-testid="builder-new-page-dialog">
      <p class="bd-dialog-art" aria-hidden="true"><svg class="icon icon-lg" aria-hidden="true"><use href="#i-layers"/></svg></p>
      <h3 id="bd-page-title" class="h3">Yeni sayfa</h3>
      <p class="text-sm text-ink-2">Bloklarla kurulan kendi sayfanız (kampanya, etkinlik, hakkımızda…). Taslak açılır; hazır olunca <strong>Yayınla</strong>.</p>
      <label class="field">
        <span class="field-label">Başlık</span>
        <input class="input" x-ref="newPageTitle" x-model="newPage.title" maxlength="120" placeholder="ör. Yaz kampanyası" required :aria-invalid="!!newPageError('title')" data-testid="builder-new-page-title">
        <span class="field-error" x-show="newPageError('title')" x-text="newPageError('title')"></span>
      </label>
      <label class="field">
        <span class="field-label">Adres <span class="font-normal text-muted">(isteğe bağlı)</span></span>
        <input class="input" x-model="newPage.slug" :placeholder="newPageSlug || 'yaz-kampanyasi'" autocomplete="off" spellcheck="false" :aria-invalid="!!newPageError('slug')">
        <span class="field-help" x-text="'Sitede: ' + newPagePath"></span>
        <span class="field-error" x-show="newPageError('slug')" x-text="newPageError('slug')"></span>
      </label>
      <div class="flex justify-end gap-2">
        <button type="button" class="btn btn-ghost btn-sm" @click="newPage.open = false">Vazgeç</button>
        <button type="submit" class="btn btn-primary btn-sm" :disabled="newPage.busy || !newPage.title.trim()" data-testid="builder-new-page-create">
          <svg class="icon icon-sm" :class="newPage.busy && 'animate-spin'" aria-hidden="true"><use :href="newPage.busy ? '#i-loader' : '#i-plus'"/></svg> Sayfayı aç
        </button>
      </div>
    </form>
  </div>

  <div class="bd-modal" x-show="revisions.open" x-cloak @keydown.escape.window="revisions.open = false" x-transition.opacity>
    <div class="bd-dialog" role="dialog" aria-modal="true" aria-labelledby="bd-rev-title" @click.outside="revisions.open = false">
      <h3 id="bd-rev-title" class="h3">Yayın geçmişi</h3>
      <p class="text-sm text-ink-2"><span x-text="zoneLabel(revisions.zone)"></span>: önceki yayınlar. Seçtiğiniz hal taslağa alınır; yayınlamak size kalır.</p>
      <template x-if="revisions.loading"><div class="skeleton h-24"></div></template>
      <template x-if="!revisions.loading && !revisions.items.length"><p class="text-sm text-muted">Bu bölgenin önceki yayını yok.</p></template>
      <div class="bd-revs">
        <template x-for="r in revisions.items" :key="r.id">
          <div class="bd-rev">
            <span class="min-w-0 flex-1">
              <span class="block text-sm font-medium text-ink" x-text="when(r.createdAt)"></span>
              <span class="block text-xs text-muted" x-text="(r.user || '—') + ' · ' + r.count + ' blok'"></span>
            </span>
            <button type="button" class="btn btn-secondary btn-sm" @click="restore(r)">Bu hale dön</button>
          </div>
        </template>
      </div>
      <div class="flex justify-between gap-2">
        <button type="button" class="btn btn-ghost btn-sm" @click="resetZone(revisions.zone); revisions.open = false" title="Derlemedeki ilk bloklara döner (taslak)">Varsayılana dön</button>
        <button type="button" class="btn btn-secondary btn-sm" @click="revisions.open = false">Kapat</button>
      </div>
    </div>
  </div>
</div>
