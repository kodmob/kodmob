{# Bülten. Mantık: panel/newsletter.js; kodmob-api Modules\Newsletter. Aboneler tablosu: ui/grid (kmGrid). #}
<div class="pn-page" x-data="kmNewsletter(r)" data-testid="newsletter">
  <div class="pn-bar">
    <div class="min-w-0 flex-1">
      <p class="pn-bar-title">Bülten</p>
      <p class="pn-bar-meta">
        <span><strong class="text-ink" x-text="audience[''] ?? 0"></strong> onaylı abone</span>
        <span>Saatte en çok <span x-text="limit"></span> e-posta</span>
      </p>
    </div>
    <button type="button" class="btn btn-primary" x-show="tab === 'campaigns'" @click="open()" data-testid="campaign-new"><svg class="icon icon-sm" aria-hidden="true"><use href="#i-plus"/></svg> Yeni bülten</button>
    <button type="button" class="btn btn-primary" x-show="tab === 'subscribers'" x-cloak @click="openAdd()" data-testid="subscriber-new"><svg class="icon icon-sm" aria-hidden="true"><use href="#i-plus"/></svg> Abone ekle</button>
  </div>

  <div class="pn-tabs w-max" role="tablist" aria-label="Bülten">
    <template x-for="t in tabs" :key="t.key">
      <button type="button" role="tab" class="pn-tab" :aria-selected="tab === t.key" @click="show(t.key)" :data-tab="t.key">
        <svg class="icon icon-sm" aria-hidden="true"><use :href="'#i-' + t.icon"/></svg> <span x-text="t.label"></span>
      </button>
    </template>
  </div>

  <p class="pn-alert" role="alert" x-show="!cron && campaigns.some((c) => c.status === 'sending')" x-cloak>
    Zamanlanmış görevler (cron) çalışmıyor: gönderim yalnızca bu sayfa açıkken ilerler. Hosting › Cron Jobs'ta her dakika <span class="code">schedule:run</span> ekleyin.
  </p>

  {# ============================================================ bültenler #}
  <div x-show="tab === 'campaigns'">
    <template x-if="loading"><div class="flex flex-col gap-3"><span class="skeleton h-24"></span><span class="skeleton h-24"></span></div></template>
    <template x-if="!loading && !campaigns.length">
      <div class="card card-body flex flex-col items-center gap-3 py-12 text-center">
        <span class="icon-tile"><svg class="icon" aria-hidden="true"><use href="#i-send"/></svg></span>
        <p class="font-semibold text-ink">Henüz bülten yok</p>
        <p class="max-w-md text-sm text-ink-2">Bülteni yazın, kendinize deneme gönderin, sonra onaylı abonelere gönderin. Sitede abone toplamak için Sayfa düzenleyicide "Bülten aboneliği" bloğunu ekleyin.</p>
        <button type="button" class="btn btn-primary" @click="open()"><svg class="icon icon-sm" aria-hidden="true"><use href="#i-plus"/></svg> Yeni bülten</button>
      </div>
    </template>
    <div class="flex flex-col gap-3" x-show="!loading">
      <template x-for="c in campaigns" :key="c.id">
        <section class="card card-body flex flex-col gap-3" :data-campaign="c.id" data-testid="campaign">
          <div class="flex flex-wrap items-start gap-3">
            <div class="min-w-0 flex-1">
              <p class="flex flex-wrap items-center gap-2 font-semibold text-ink">
                <span x-text="c.subject"></span>
                <span class="badge" :class="status('campaign', c.status).cls" x-text="status('campaign', c.status).label" data-testid="campaign-status"></span>
              </p>
              <p class="mt-1 text-sm text-muted">
                <span x-show="c.status === 'draft'" x-text="audienceText(c.locale)"></span>
                <span x-show="c.status !== 'draft'"><span x-text="c.sent" data-testid="campaign-sent"></span> / <span x-text="c.total"></span> gönderildi<span x-show="c.failed" x-text="' · ' + c.failed + ' başarısız'"></span></span>
                <span x-show="c.finished_at" x-text="' · ' + fmt.dateTime(c.finished_at)"></span>
              </p>
            </div>
            <div class="flex flex-wrap gap-2">
              <template x-if="c.status === 'draft'">
                <button type="button" class="btn btn-secondary btn-sm" @click="open(c)"><svg class="icon icon-sm" aria-hidden="true"><use href="#i-pencil"/></svg> Düzenle</button>
              </template>
              <template x-if="c.status === 'draft' || c.status === 'paused'">
                <button type="button" class="btn btn-primary btn-sm" @click="send(c)" :disabled="busy !== null" data-testid="campaign-send"><svg class="icon icon-sm" aria-hidden="true"><use href="#i-send"/></svg> <span x-text="c.status === 'paused' ? 'Devam et' : 'Gönder'"></span></button>
              </template>
              <template x-if="c.status === 'sending'">
                <button type="button" class="btn btn-secondary btn-sm" @click="pause(c)" :disabled="busy !== null" data-testid="campaign-pause"><svg class="icon icon-sm" aria-hidden="true"><use href="#i-clock"/></svg> Duraklat</button>
              </template>
              <template x-if="c.status !== 'sending'">
                <button type="button" class="btn-icon" @click="remove(c)" aria-label="Sil" title="Sil"><svg class="icon icon-sm" aria-hidden="true"><use href="#i-trash"/></svg></button>
              </template>
            </div>
          </div>
          <template x-if="c.status !== 'draft'">
            <div class="progress" :class="c.status === 'sent' && 'is-done'"><span :style="{ width: progress(c) + '%' }"></span></div>
          </template>
          <p class="pn-alert" role="alert" x-show="c.error" x-text="'Gönderim durdu: ' + c.error + ' · E-posta ayarlarını Sistem Ayarları › E-posta\'da deneyin, sonra Devam et.'"></p>
        </section>
      </template>
    </div>
  </div>

  {# ============================================================ aboneler #}
  <div x-show="tab === 'subscribers'" x-cloak>
    <template x-if="grid">
      <div x-data="kmGrid(grid)" @grid-action="onAction($event.detail)">
        {% include "ui/grid/grid.html" %}
      </div>
    </template>
  </div>

  {# ============================================================ bülten penceresi #}
  <template x-if="editing">
    <div>
      <div class="pn-modal-backdrop" @click="busy || (editing = false)"></div>
      <div class="pn-modal-wrap">
        <form class="pn-modal max-w-3xl" role="dialog" aria-modal="true" aria-labelledby="campaign-title" @submit.prevent="save()" @keydown.escape.window="busy || (editing = false)" data-testid="campaign-form">
          <header class="pn-modal-head">
            <h2 id="campaign-title" class="h3" x-text="form.id ? 'Bülteni düzenle' : 'Yeni bülten'"></h2>
            <button type="button" class="btn-icon ml-auto" @click="editing = false" :disabled="busy" aria-label="Kapat"><svg class="icon" aria-hidden="true"><use href="#i-x"/></svg></button>
          </header>
          <div class="flex flex-col gap-4 p-5">
            <div class="field">
              <label class="field-label" for="campaign-subject">Konu</label>
              <input id="campaign-subject" class="input" x-model="form.subject" maxlength="200" :aria-invalid="!!errors.subject" required>
              <p class="field-error" x-show="errors.subject" x-text="errors.subject"></p>
            </div>
            <div class="field">
              <label class="field-label" for="campaign-locale">Kime</label>
              <select id="campaign-locale" class="input" x-model="form.locale" :aria-invalid="!!errors.locale">
                <template x-for="l in languages" :key="l.code">
                  <option :value="l.code" x-text="audienceText(l.code)" :selected="form.locale === l.code"></option>
                </template>
              </select>
              <p class="field-help">Abone, abone olduğu sayfanın dilinde sayılır. Her e-postanın altında abonelikten çıkma bağlantısı olur.</p>
              <p class="field-error" x-show="errors.locale" x-text="errors.locale"></p>
            </div>
            <div class="field">
              <span class="field-label">İçerik</span>
              <div class="rte" x-data="kmRichText(() => form.body, (value) => form.body = value, () => form.locale || 'tr')" data-testid="campaign-body">
                <div class="rte-toolbar" role="toolbar" aria-label="Biçimlendirme">
                  <button type="button" class="rte-btn" :class="is('heading', { level: 2 }) && 'is-active'" @click="run('toggleHeading', { level: 2 })" title="Başlık">H2</button>
                  <button type="button" class="rte-btn" :class="is('heading', { level: 3 }) && 'is-active'" @click="run('toggleHeading', { level: 3 })" title="Alt başlık">H3</button>
                  <span class="rte-sep" aria-hidden="true"></span>
                  <button type="button" class="rte-btn font-bold" :class="is('bold') && 'is-active'" @click="run('toggleBold')" title="Kalın (Ctrl+B)">B</button>
                  <button type="button" class="rte-btn italic" :class="is('italic') && 'is-active'" @click="run('toggleItalic')" title="İtalik (Ctrl+I)">I</button>
                  <button type="button" class="rte-btn" :class="is('link') && 'is-active'" @click="link()" title="Bağlantı"><svg class="icon icon-sm" aria-hidden="true"><use href="#i-link"/></svg></button>
                  <span class="rte-sep" aria-hidden="true"></span>
                  <button type="button" class="rte-btn" :class="is('bulletList') && 'is-active'" @click="run('toggleBulletList')" title="Madde listesi"><svg class="icon icon-sm" aria-hidden="true"><use href="#i-list"/></svg></button>
                  <button type="button" class="rte-btn" :class="is('orderedList') && 'is-active'" @click="run('toggleOrderedList')" title="Numaralı liste">1.</button>
                  <button type="button" class="rte-btn" :class="is('blockquote') && 'is-active'" @click="run('toggleBlockquote')" title="Alıntı"><svg class="icon icon-sm" aria-hidden="true"><use href="#i-quote"/></svg></button>
                  <button type="button" class="rte-btn" @click="image()" title="Görsel ekle"><svg class="icon icon-sm" aria-hidden="true"><use href="#i-image"/></svg></button>
                  <span class="rte-sep" aria-hidden="true"></span>
                  <button type="button" class="rte-btn" @click="run('undo')" :disabled="!can('undo')" title="Geri al (Ctrl+Z)"><svg class="icon icon-sm" aria-hidden="true"><use href="#i-rotate-ccw"/></svg></button>
                  <button type="button" class="rte-btn" @click="run('redo')" :disabled="!can('redo')" title="Yinele (Ctrl+Y)"><svg class="icon icon-sm -scale-x-100" aria-hidden="true"><use href="#i-rotate-ccw"/></svg></button>
                </div>
                <div x-ref="area" class="rte-area"></div>
              </div>
              <p class="field-error" x-show="errors.body" x-text="errors.body"></p>
            </div>
          </div>
          <footer class="pn-modal-foot flex-wrap">
            <button type="button" class="btn btn-ghost mr-auto" @click="test()" :disabled="busy" data-testid="campaign-test">
              <svg class="icon icon-sm" :class="busy === 'test' && 'animate-spin'" aria-hidden="true"><use :href="busy === 'test' ? '#i-loader' : '#i-mail'"/></svg> Kendime deneme gönder
            </button>
            <button type="submit" class="btn btn-secondary" :disabled="busy" data-testid="campaign-save">Taslağı kaydet</button>
            <button type="button" class="btn btn-primary" @click="saveAndSend()" :disabled="busy" data-testid="campaign-save-send"><svg class="icon icon-sm" aria-hidden="true"><use href="#i-send"/></svg> Gönder</button>
          </footer>
        </form>
      </div>
    </div>
  </template>

  {# ============================================================ abone ekle #}
  <template x-if="addOpen">
    <div>
      <div class="pn-modal-backdrop" @click="busy || (addOpen = false)"></div>
      <div class="pn-modal-wrap">
        <form class="pn-modal max-w-md" role="dialog" aria-modal="true" aria-labelledby="subscriber-title" @submit.prevent="add()" @keydown.escape.window="busy || (addOpen = false)" data-testid="subscriber-form">
          <header class="pn-modal-head">
            <h2 id="subscriber-title" class="h3">Abone ekle</h2>
            <button type="button" class="btn-icon ml-auto" @click="addOpen = false" :disabled="busy" aria-label="Kapat"><svg class="icon" aria-hidden="true"><use href="#i-x"/></svg></button>
          </header>
          <div class="flex flex-col gap-4 p-5">
            <p class="text-sm text-ink-2">Kişiye onay e-postası gider; bağlantıya tıklayınca abone olur (onaysız kimse listeye girmez).</p>
            <div class="field">
              <label class="field-label" for="subscriber-email">E-posta</label>
              <input id="subscriber-email" type="email" class="input" x-model="adding.email" maxlength="190" :aria-invalid="!!errors.email" required>
              <p class="field-error" x-show="errors.email" x-text="errors.email"></p>
            </div>
            <div class="field">
              <label class="field-label" for="subscriber-name">Ad <span class="text-xs font-normal text-muted">(isteğe bağlı)</span></label>
              <input id="subscriber-name" class="input" x-model="adding.name" maxlength="120">
            </div>
            <div class="field" x-show="languages.length > 2">
              <label class="field-label" for="subscriber-locale">Dil</label>
              <select id="subscriber-locale" class="input" x-model="adding.locale">
                <template x-for="l in languages.filter((l) => l.code)" :key="l.code"><option :value="l.code" x-text="l.label" :selected="adding.locale === l.code"></option></template>
              </select>
            </div>
          </div>
          <footer class="pn-modal-foot">
            <button type="button" class="btn btn-ghost" @click="addOpen = false" :disabled="busy">Vazgeç</button>
            <button type="submit" class="btn btn-primary" :disabled="busy" data-testid="subscriber-save">Onay e-postası gönder</button>
          </footer>
        </form>
      </div>
    </div>
  </template>
</div>
