{# Panel araması sonuçları (masaüstü açılır kutu ve mobil katman). Kapsam: kmSearch; searchList: desktop | mobile. #}
<div class="pn-search py-1" role="listbox" id="km-search-list-{{ searchList }}" data-search-list="{{ searchList }}" aria-label="Arama sonuçları">
  <template x-for="g in groups" :key="g.key">
    <div class="pb-1">
      <div class="flex items-center justify-between gap-2 px-4 pt-2.5 pb-1">
        <p class="text-[0.6875rem] font-semibold tracking-wider text-muted uppercase" x-text="g.label"></p>
        <button type="button" class="text-xs font-medium text-muted hover:text-ink" x-show="g.key === 'recent'" @click="clearRecent()">Temizle</button>
      </div>
      <template x-for="item in g.items" :key="item.key">
        <a :href="link(item)" role="option" :id="'km-search-{{ searchList }}-' + item.key" :aria-selected="item.key === activeKey" :data-search-key="item.key" :data-search-active="item.key === activeKey"
          class="mx-1.5 flex min-h-12 items-center gap-3 rounded-control px-2.5 py-1.5" :class="item.key === activeKey ? 'bg-primary-soft' : 'hover:bg-surface-subtle'"
          :title="item.hint || ''" @mouseenter="hover(item)" @click="picked(item)">
          <span class="tone-icon h-8 w-8" :class="item.anchor ? 'tone-warning' : 'tone-neutral'"><svg class="icon icon-sm" aria-hidden="true"><use :href="'#i-' + (item.icon || 'search')"/></svg></span>
          <span class="min-w-0 flex-1">
            <span class="block truncate text-sm font-medium text-ink" x-html="item.html"></span>
            <span class="block truncate text-xs text-muted" x-text="item.path"></span>
          </span>
          <span class="badge badge-neutral shrink-0" x-show="item.badge" x-text="item.badge"></span>
          <span class="hidden shrink-0 text-xs text-muted sm:inline" x-show="item.anchor && item.key === activeKey">Ayara git</span>
          <svg class="icon icon-sm shrink-0 text-muted" aria-hidden="true"><use href="#i-chevron-right"/></svg>
        </a>
      </template>
    </div>
  </template>

  <p class="flex items-center gap-2 px-4 py-2 text-xs text-muted" x-show="loading && hasQuery" x-cloak>
    <svg class="icon icon-sm animate-spin" aria-hidden="true"><use href="#i-loader"/></svg> Kayıtlarda aranıyor…
  </p>
  <div class="px-4 py-5 text-sm text-ink-2" x-show="empty" x-cloak>
    <p class="font-medium text-ink">"<span x-text="q"></span>" için sonuç yok.</p>
    <p class="mt-1">Başka bir kelime deneyin: ayarın adı (smtp, telefon, robots), sayfa (yönlendirmeler) ya da kayıt adı.</p>
  </div>
  <div class="px-4 py-4 text-sm text-ink-2" x-show="!hasQuery && !recent.length">
    <p class="font-medium text-ink">Sayfa, ayar ya da kayıt arayın.</p>
    <p class="mt-1">Ör. <span class="font-mono text-xs">smtp</span>, <span class="font-mono text-xs">iki adımlı</span>, <span class="font-mono text-xs">yönlendirme</span>, bir projenin ya da kullanıcının adı. Ayar sonucu ilgili sayfayı açıp alanı gösterir.</p>
  </div>
  {% if searchList == 'desktop' %}
  <p class="mt-1 flex flex-wrap gap-x-4 gap-y-1 border-t border-line px-4 py-2 text-xs text-muted">
    <span><kbd class="pn-kbd">↑</kbd> <kbd class="pn-kbd">↓</kbd> seç</span>
    <span><kbd class="pn-kbd">Enter</kbd> aç</span>
    <span><kbd class="pn-kbd">Esc</kbd> kapat</span>
    <span class="ml-auto"><kbd class="pn-kbd" x-text="shortcut"></kbd> her yerden</span>
  </p>
  {% endif %}
</div>
