{% extends "layouts/base.njk" %}

{#
  404 / 410 sayfası (her dil için ayrı kabuk: _pages/<dil>/404.html; render.php adresin diline göre seçer).
  Kayıt başka dillerde varsa "şu dillerde mevcut" (sunucu, #km-data `available`; dil seçici de oraya gider),
  benzer adresler "Bunu mu demek istediniz?" (tarayıcı, GET /suggest; HTML önbellekte kalabilsin diye).
  Mantık: pages/404/not-found.js. Ana sayfaya yönlendirme yok (soft 404 olmasın).
#}
{% block content %}
<section class="container-site grid min-h-[60vh] place-items-center py-20">
  <div class="card w-full max-w-lg p-8 text-center fade-up" x-data="kmNotFound" data-testid="not-found">
    <p class="text-sm font-semibold tabular-nums text-primary" x-text="gone ? '410' : '404'">404</p>
    <h1 class="h2 mt-2"><span x-show="!gone">{{ t('notFound.title') }}</span><span x-show="gone" x-cloak>{{ t('notFound.goneTitle') }}</span></h1>
    <p class="mt-3 text-ink-2"><span x-show="!gone">{{ t('notFound.text') }}</span><span x-show="gone" x-cloak>{{ t('notFound.goneText') }}</span></p>

    <div class="mt-6 rounded-tile border border-primary/25 bg-primary-soft/40 p-4 text-left" x-show="available.length" x-cloak data-testid="nf-available">
      <p class="text-sm font-semibold text-ink">{{ t('notFound.available') }}</p>
      <ul class="mt-3 flex flex-wrap gap-2">
        <template x-for="a in available" :key="a.code">
          <li><a :href="a.url" :hreflang="a.code" :lang="a.code" class="btn btn-secondary btn-sm"><img class="flag" :src="'/assets/img/flags/' + a.code + '.svg'" alt="" width="20" height="14"> <span x-text="a.label"></span></a></li>
        </template>
      </ul>
    </div>

    <div class="mt-6 text-left" x-show="suggestions.length" x-cloak data-testid="nf-suggestions">
      <p class="text-sm font-semibold text-ink">{{ t('notFound.didYouMean') }}</p>
      <ul class="mt-2 flex flex-col gap-1.5">
        <template x-for="s in suggestions" :key="s.url">
          <li><a :href="s.url" class="link-arrow inline-flex items-center gap-1.5 text-sm font-medium text-primary"><span x-text="s.title"></span> <svg class="icon icon-sm" aria-hidden="true"><use href="#i-arrow-right"/></svg></a></li>
        </template>
      </ul>
    </div>

    <div class="mt-6 flex flex-col justify-center gap-3 sm:flex-row">
      <a href="{{ url('home') }}" class="btn btn-primary">{{ t('notFound.back') }} <svg class="icon icon-sm icon-arrow" aria-hidden="true"><use href="#i-arrow-right"/></svg></a>
      <button type="button" class="btn btn-secondary" @click="$store.search.show()"><svg class="icon icon-sm" aria-hidden="true"><use href="#i-search"/></svg> {{ t('nav.search') }}</button>
    </div>
    <p class="mt-4 text-sm text-muted">{{ t('notFound.search') }}</p>

    <nav class="mt-6 border-t border-line pt-5" aria-label="{{ t('notFound.popular') }}">
      <p class="text-xs font-semibold tracking-wider text-muted uppercase">{{ t('notFound.popular') }}</p>
      <ul class="mt-2 flex flex-wrap justify-center gap-x-5 gap-y-1.5 text-sm" x-show="popular.length" x-cloak>
        <template x-for="link in popular" :key="link.url"><li><a :href="link.url" class="font-medium text-ink-2 hover:text-primary" x-text="link.label"></a></li></template>
      </ul>
      <ul class="mt-2 flex flex-wrap justify-center gap-x-5 gap-y-1.5 text-sm" x-show="!popular.length">
        {% for name in ['blog', 'contact'] %}{% if url(name) %}
        <li><a href="{{ url(name) }}" class="font-medium text-ink-2 hover:text-primary">{{ t('nav.' + name) }}</a></li>
        {% endif %}{% endfor %}
      </ul>
    </nav>
  </div>
</section>
{% endblock %}
