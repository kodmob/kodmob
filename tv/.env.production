# npm run build — canlı ortam. Frontend kökte, Laravel API /api/ altında (aynı
# origin); bu yüzden adres göreli ve CSP connect-src 'self' yeterli.
VITE_APP_NAME=Kodmob

VITE_BASE_URL=/api
VITE_API_BASE_PATH=/v1
VITE_AUTH_BASE_PATH=/v1/auth

VITE_DEBUG_MODE=false

# Sitenin tam adresi: canonical, hreflang ve sitemap.xml bununla kurulur.
# Boşsa profilin site.config.js `url`'si.
SITE_URL=
# Arama motorları için tek anahtar: false iken bütün sayfalar noindex ve robots.txt her şeyi kapatır.
# Sayfaların robots etiketi, X-Robots-Tag başlığı (render.php) ve robots.txt buna göre üretilir.
# Panel ve bileşen vitrini her durumda kapalıdır.
SITE_INDEXABLE=false
