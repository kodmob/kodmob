{# Kayıttaki ayarların formu (gruplu kartlar, kaydet / vazgeç): Proje Ayarları ve Sistem Ayarları › Genel.
   kmSettings kapsamında (panel/settings.js); `scope` project | system. #}
<div class="flex flex-col gap-5" x-show="tab === 'general'">
  <div class="pn-bar" x-show="loading || items.length">
    <div class="min-w-0 flex-1">
      <p class="pn-bar-title" x-text="scope === 'project' ? 'Proje ayarları' : 'Genel'"></p>
      <p class="pn-bar-meta"><span x-text="scope === 'project' ? 'Kimlik, iletişim, sosyal medya ve yasal bilgiler sitede hemen güncellenir.' : 'Kurulumun tamamını ilgilendiren ayarlar.'"></span><span class="pn-dirty" x-show="changed.length" x-cloak x-text="'● ' + changed.length + ' değişiklik'"></span></p>
    </div>
    <button type="button" class="btn btn-ghost" x-show="changed.length" x-cloak @click="reset()">Vazgeç</button>
    <button type="button" class="btn btn-primary" @click="save()" :disabled="saving || !changed.length">
      <svg class="icon icon-sm animate-spin" aria-hidden="true" x-show="saving" x-cloak><use href="#i-loader"/></svg>
      <span x-text="saving ? 'Kaydediliyor…' : 'Kaydet'">Kaydet</span>
    </button>
  </div>

  <p class="pn-hint" x-show="scope === 'system' && child" x-cloak data-testid="settings-shared"><svg class="icon icon-sm" aria-hidden="true"><use href="#i-info"/></svg><span>E-posta, SMS ve yapay zekâ ayarları ana projede yönetilir; bu proje onları kullanır.</span></p>

  <template x-if="loading">
    <div class="flex flex-col gap-4"><span class="skeleton h-48"></span><span class="skeleton h-48"></span></div>
  </template>

  {# Proje Ayarları: her grup bir sekme (Kimlik, İletişim, Yasal, Mağaza…); değişiklik olan sekmede nokta. #}
  <div class="-mx-1 overflow-x-auto px-1" x-show="scope === 'project' && !loading && groupTabs.length > 1" x-cloak>
    <div class="pn-tabs w-max" role="tablist" aria-label="Ayar grupları" data-testid="settings-groups">
      <template x-for="t in groupTabs" :key="t.key">
        <button type="button" role="tab" class="pn-tab" :aria-selected="group === t.key" @click="pickGroup(t.key)" :data-group="t.key">
          <span x-text="t.label"></span><span class="text-primary" x-show="t.dirty" aria-label="kaydedilmemiş değişiklik">●</span>
        </button>
      </template>
    </div>
  </div>

  <div class="pn-settings" x-show="!loading">
    <template x-for="g in shownGroups" :key="g.name">
      <section class="card pn-group-card">
        <h3 class="pn-group-title" x-text="g.name"></h3>
        <div class="pn-grid">
          <template x-for="s in g.items" :key="s.key">
            {% include "pages/panel/_setting-field.njk" %}
          </template>
        </div>
      </section>
    </template>
  </div>
</div>
