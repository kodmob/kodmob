<div class="pn-page" x-data="kmOverview">
  <div class="pn-hello">
    <div>
      <h2 class="h2" x-text="greeting"></h2>
      <p class="mt-1 text-ink-2">Sitedeki içerik burada. Kaydettiğiniz her değişiklik anında yayında.</p>
    </div>
    <div class="flex flex-wrap gap-2">
      <template x-if="firstType">
        <a :href="$href('editor', { type: firstType.key, id: 0 })" class="btn btn-primary"><svg class="icon icon-sm" aria-hidden="true"><use href="#i-plus"/></svg> <span x-text="firstType.newLabel"></span></a>
      </template>
      <a :href="$href('editor', { type: 'posts', id: 0 })" class="btn btn-secondary" x-show="$store.session.can('km_manage_posts')"><svg class="icon icon-sm" aria-hidden="true"><use href="#i-pencil"/></svg> Yeni yazı</a>
      <a :href="$href('other')" class="btn btn-ghost" data-testid="overview-all"><svg class="icon icon-sm" aria-hidden="true"><use href="#i-grid"/></svg> Tüm işlemler</a>
    </div>
  </div>

  {# Sıradaki adımlar: siteyi yayına hazırlarken sırayla; adım yapılınca kendiliğinden işaretlenir. #}
  <template x-if="!loading && steps.length && !stepsHidden">
    <section class="card pn-steps" data-testid="next-steps">
      <div class="flex flex-wrap items-center gap-3">
        <div class="min-w-0 flex-1">
          <h2 class="text-base font-semibold text-ink" x-text="nextStep ? 'Sıradaki adımlar' : 'Siteniz hazır'"></h2>
          <p class="text-sm text-ink-2" x-text="nextStep ? 'Siteyi yayına hazırlamak için sırayla; yaptıkça kendiliğinden işaretlenir.' : 'Bütün adımlar tamam. Bu kartı gizleyebilirsiniz.'"></p>
        </div>
        <span class="pn-steps-count" x-text="stepsDone + ' / ' + steps.length"></span>
        <button type="button" class="btn btn-ghost btn-sm" @click="toggleSteps(true)" data-testid="next-steps-hide">Gizle</button>
      </div>
      <div class="pn-steps-bar" role="progressbar" :aria-valuenow="stepsDone" aria-valuemin="0" :aria-valuemax="steps.length"><span :style="{ width: Math.round(stepsDone / steps.length * 100) + '%' }"></span></div>
      <ol class="pn-steps-list">
        <template x-for="(step, i) in steps" :key="step.key">
          <li :class="step.done ? 'is-done' : (step === nextStep ? 'is-next' : '')" :data-step="step.key">
            <span class="pn-steps-num" aria-hidden="true">
              <svg class="icon icon-sm" x-show="step.done"><use href="#i-check"/></svg>
              <span x-show="!step.done" x-text="i + 1"></span>
            </span>
            <span class="min-w-0 flex-1">
              <span class="block font-medium text-ink" x-text="step.label"></span>
              <span class="block text-sm text-ink-2" x-show="!step.done" x-text="step.hint"></span>
            </span>
            <a :href="stepHref(step)" class="btn btn-sm" :class="step === nextStep ? 'btn-primary' : 'btn-ghost'" x-text="step.done ? 'Aç' : 'Başla'"></a>
          </li>
        </template>
      </ol>
    </section>
  </template>
  <p class="text-sm text-muted" x-show="!loading && steps.length && stepsHidden" x-cloak>
    <button type="button" class="font-medium text-primary hover:underline" @click="toggleSteps(false)" data-testid="next-steps-show">Sıradaki adımları göster</button>
    <span x-text="'(' + stepsDone + ' / ' + steps.length + ' tamam)'"></span>
  </p>

  {# Kartlar (widget): modüllerden; kişi sıralar, boyutlandırır, gizler (panel/overview.js). #}
  <div class="flex flex-wrap items-center justify-between gap-3">
    <h2 class="text-base font-semibold text-ink">Özet</h2>
    <div class="flex flex-wrap gap-2">
      <button type="button" class="btn btn-ghost btn-sm" x-show="editing && custom" @click="reset()" data-testid="widgets-reset">Varsayılana dön</button>
      <button type="button" class="btn btn-sm" :class="editing ? 'btn-primary' : 'btn-ghost'" @click="editing = !editing" :aria-pressed="editing" data-testid="widgets-edit">
        <svg class="icon icon-sm" aria-hidden="true"><use :href="editing ? '#i-check' : '#i-sliders'"/></svg> <span x-text="editing ? 'Bitti' : 'Kartları düzenle'"></span>
      </button>
    </div>
  </div>

  <template x-if="widgetsLoading">
    <div class="pn-widgets"><span class="skeleton h-40 md:col-span-2 xl:col-span-4"></span><span class="skeleton h-56 xl:col-span-2"></span><span class="skeleton h-56 xl:col-span-2"></span></div>
  </template>

  <div class="pn-widgets" :class="editing && 'is-editing'" x-show="!widgetsLoading" data-testid="widgets">
    <template x-for="(w, i) in shown" :key="w.key">
      <section class="card pn-widget overflow-hidden" :data-size="w.size" :data-widget="w.key" :class="{ 'is-dragging': dragging === w.key, 'is-over': over === w.key && dragging !== w.key }"
        :draggable="editing" @dragstart="editing && dragStart(w.key, $event)" @dragend="dragging = null; over = null"
        @dragover.prevent="editing && (over = w.key)" @drop.prevent="editing && drop(w.key)">
        {# Düzenleme araçları #}
        <div class="pn-widget-tools" x-show="editing" x-cloak>
          <svg class="icon icon-sm cursor-grab text-muted" aria-hidden="true"><use href="#i-grip"/></svg>
          <button type="button" class="btn-icon h-8 w-8" @click="move(w.key, -1)" :disabled="i === 0" aria-label="Öne al" title="Öne al"><svg class="icon icon-sm" aria-hidden="true"><use href="#i-chevron-left"/></svg></button>
          <button type="button" class="btn-icon h-8 w-8" @click="move(w.key, 1)" :disabled="i === shown.length - 1" aria-label="Arkaya al" title="Arkaya al"><svg class="icon icon-sm" aria-hidden="true"><use href="#i-chevron-right"/></svg></button>
          <label class="sr-only" :for="'size-' + w.key">Boyut</label>
          <select class="input h-8 w-auto py-0 text-sm" :id="'size-' + w.key" @change="setSize(w.key, $event.target.value)" data-testid="widget-size">
            <template x-for="s in sizes" :key="s.key"><option :value="s.key" x-text="s.label" :selected="s.key === w.size"></option></template>
          </select>
          <button type="button" class="btn-icon ms-auto h-8 w-8" @click="hide(w.key)" aria-label="Gizle" title="Gizle" data-testid="widget-hide"><svg class="icon icon-sm" aria-hidden="true"><use href="#i-eye-off"/></svg></button>
        </div>

        <div class="pn-card-head">
          <h3 class="h3 flex min-w-0 items-center gap-2"><svg class="icon text-primary" aria-hidden="true"><use :href="'#i-' + w.icon"/></svg> <span class="truncate" x-text="w.label"></span></h3>
          <template x-if="w.link"><a :href="$href(w.link.route, w.link.params || {})" class="link-arrow shrink-0 text-sm"><span x-text="w.link.label"></span> <svg class="icon icon-sm" aria-hidden="true"><use href="#i-arrow-right"/></svg></a></template>
        </div>

        <template x-if="w.data && w.data.error"><p class="px-5 pb-5 text-sm text-danger" x-text="w.data.error"></p></template>

        {# Sayılar #}
        <template x-if="w.type === 'stats' && w.data && !w.data.error">
          <div class="pn-widget-stats">
            <template x-for="(s, j) in w.data.items" :key="j">
              <a :href="link(s)" class="pn-widget-stat" :class="!link(s) && 'pointer-events-none'">
                <span class="pn-stat-label" x-text="s.label"></span>
                <span class="pn-stat-value mt-1" x-text="s.value"></span>
                <span class="pn-stat-sub" x-show="s.sub" x-text="s.sub"></span>
              </a>
            </template>
          </div>
        </template>

        {# Satırlar #}
        <template x-if="w.type === 'list' && w.data && !w.data.error">
          <div>
            <p class="px-5 pb-1 text-sm font-medium text-primary" x-show="w.data.note" x-text="w.data.note"></p>
            <ul class="pn-feed">
              <template x-for="(item, j) in w.data.items" :key="j">
                <li><a :href="link(item)" class="pn-feed-item">
                  <span class="min-w-0 flex-1">
                    <span class="block truncate font-semibold text-ink" x-text="item.title"></span>
                    <span class="block truncate text-xs text-muted"><span x-text="item.meta"></span><span x-show="item.meta && item.time"> · </span><span x-text="when(item.time)"></span></span>
                  </span>
                  <template x-if="item.badge"><span class="badge shrink-0" :class="badgeClass(item.badge)" x-text="item.badge[0]"></span></template>
                </a></li>
              </template>
              <li x-show="!w.data.items.length" class="px-5 py-6 text-sm text-muted" x-text="w.data.empty || 'Kayıt yok.'"></li>
            </ul>
          </div>
        </template>

        {# Domain taramaları (özel kart; veriyi kendisi ister) #}
        <template x-if="w.key === 'domains'">
          <div class="px-5 pb-5" x-data="{ jobs: [] }" x-init="api.jarvis().then((r) => { jobs = r.jobs || []; }).catch(() => {})">
            <p class="text-sm text-ink-2" x-show="!jobs.length">Süren tarama yok. Domain aramada kısa adları tarayabilirsiniz.</p>
            <ul class="flex flex-col gap-3" x-show="jobs.length">
              <template x-for="job in jobs" :key="job.id">
                <li><a :href="$href('domains', { job: job.id })" class="block rounded-control border border-line p-3 hover:bg-surface-subtle">
                  <span class="flex items-center justify-between gap-3 text-sm"><span class="truncate font-medium text-ink" x-text="job.title"></span><span class="num shrink-0 text-xs text-ink-2" x-text="job.found + ' boş · %' + job.progress"></span></span>
                  <span class="progress mt-2 block"><span :style="{ width: job.progress + '%' }"></span></span>
                </a></li>
              </template>
            </ul>
          </div>
        </template>
      </section>
    </template>
  </div>

  {# Gizli kartlar: düzenlerken geri eklenir. #}
  <div class="card card-body flex flex-wrap items-center gap-2" x-show="editing && hiddenWidgets.length" x-cloak data-testid="widgets-hidden">
    <span class="text-sm font-medium text-ink-2">Gizli kartlar:</span>
    <template x-for="w in hiddenWidgets" :key="w.key">
      <button type="button" class="btn btn-secondary btn-sm" @click="show(w.key)" :data-show="w.key"><svg class="icon icon-sm" aria-hidden="true"><use href="#i-plus"/></svg> <span x-text="w.label"></span></button>
    </template>
  </div>
  <p class="text-sm text-muted" x-show="!editing && !widgetsLoading && !shown.length" x-cloak>Bütün kartlar gizli. "Kartları düzenle" ile geri ekleyin.</p>
</div>
