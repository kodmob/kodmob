{# SEO. Mantık: panel/seo.js. Tablolar: ui/grid (kmGrid). Ayar alanları: _setting-field.njk. #}
<div class="pn-page" x-data="kmSeo(r)">
  <div class="-mx-1 overflow-x-auto px-1">
    <div class="pn-tabs w-max" role="tablist" aria-label="SEO">
      <template x-for="t in tabs" :key="t.key">
        <button type="button" role="tab" class="pn-tab" :aria-selected="tab === t.key" @click="show(t.key)" x-show="visible(t)" :data-tab="t.key">
          <svg class="icon icon-sm" aria-hidden="true"><use :href="'#i-' + t.icon"/></svg> <span x-text="t.label"></span>
        </button>
      </template>
    </div>
  </div>

  {# ============================================================ genel bakış #}
  <template x-if="tab === 'overview'">
    <div class="flex flex-col gap-5">
      <template x-if="loading"><div class="pn-stats"><span class="skeleton h-28"></span><span class="skeleton h-28"></span><span class="skeleton h-28"></span><span class="skeleton h-28"></span></div></template>
      <template x-if="!loading && overview">
        <div class="flex flex-col gap-5">
          {# Ana anahtar #}
          <section class="card card-body flex flex-wrap items-center gap-4" data-testid="seo-master">
            <span class="icon-tile" :class="enabled ? '!bg-success-soft !text-success-ink' : '!bg-surface-subtle !text-muted'"><svg class="icon icon-lg" aria-hidden="true"><use href="#i-search"/></svg></span>
            <div class="min-w-0 flex-1">
              <p class="text-lg font-semibold text-ink" x-text="enabled ? 'SEO modülü açık' : 'SEO modülü kapalı'"></p>
              <p class="text-sm text-ink-2" x-text="enabled ? 'Aşağıdaki modüller ayrı ayrı açılıp kapatılabilir.' : 'Site temel etiketlerle (başlık, özet, canonical, hreflang) ve varsayılan robots.txt / site haritasıyla yayında. Ayarlar ve veriler korunuyor.'"></p>
            </div>
            <label class="pn-switch">
              <input type="checkbox" class="peer sr-only" :checked="enabled" @change.prevent="toggleSeo()" :disabled="settings.saving" data-testid="seo-toggle">
              <span class="pn-switch-track" aria-hidden="true"></span>
              <span class="field-label" x-text="enabled ? 'Açık' : 'Kapalı'"></span>
            </label>
          </section>

          <template x-if="enabled">
            <div class="flex flex-col gap-5">
              <div class="pn-stats">
                <button type="button" class="card card-hover pn-stat text-left" @click="show('content')">
                  <span class="pn-stat-label">Ortalama SEO puanı</span>
                  <span><span class="pn-stat-value" :class="overview.stats.score >= 80 ? 'text-success-ink' : overview.stats.score >= 50 ? 'text-warning-ink' : 'text-danger'" x-text="overview.stats.score ?? '—'"></span><span class="pn-stat-sub" x-text="overview.stats.records + ' sayfa · ' + overview.stats.issues + ' sorunlu'"></span></span>
                </button>
                <button type="button" class="card card-hover pn-stat text-left" @click="show('redirects')">
                  <span class="pn-stat-label">Yönlendirme</span>
                  <span><span class="pn-stat-value" x-text="fmt.number(overview.stats.redirects)"></span><span class="pn-stat-sub" x-text="fmt.number(overview.stats.redirect_hits) + ' tıklanma'"></span></span>
                </button>
                <button type="button" class="card card-hover pn-stat text-left" @click="show('404')">
                  <span class="pn-stat-label">Yeni 404</span>
                  <span><span class="pn-stat-value" :class="overview.stats.not_found && 'text-warning-ink'" x-text="fmt.number(overview.stats.not_found)"></span><span class="pn-stat-sub">ziyaretçilerin gördüğü (botlar hariç)</span></span>
                </button>
                <div class="card pn-stat">
                  <span class="pn-stat-label">Arama motorları</span>
                  <span><span class="pn-stat-value text-xl" :class="overview.indexable ? 'text-success-ink' : 'text-warning-ink'" x-text="overview.indexable ? 'Açık' : 'Kapalı'"></span><span class="pn-stat-sub" x-text="overview.indexable ? 'Site dizine eklenebilir' : 'Yayın öncesi (noindex)'"></span></span>
                </div>
              </div>

              <div class="grid items-start gap-5 xl:grid-cols-[minmax(0,1.5fr)_minmax(0,1fr)]">
                <section class="card">
                  <div class="card-header"><h3 class="card-title">Modüller</h3><span class="text-sm text-ink-2" x-text="overview.modules.filter((m) => m.on).length + ' / ' + overview.modules.length + ' açık'"></span></div>
                  <ul class="grid divide-y divide-line sm:grid-cols-2 sm:divide-y-0">
                    <template x-for="m in overview.modules" :key="m.key">
                      <li class="flex items-start gap-3 border-line px-4 py-3 sm:border-b" :data-setting="'seo.module.' + m.key">
                        <span class="icon-tile icon-tile-sm shrink-0" :class="!m.on && '!bg-surface-subtle !text-muted'"><svg class="icon icon-sm" aria-hidden="true"><use :href="'#i-' + m.icon"/></svg></span>
                        <span class="min-w-0 flex-1">
                          <span class="block text-sm font-semibold text-ink" x-text="m.label"></span>
                          <span class="block text-xs text-ink-2" x-text="m.description"></span>
                        </span>
                        <label class="pn-switch shrink-0" :title="m.on ? 'Kapat' : 'Aç'">
                          <input type="checkbox" class="peer sr-only" :checked="m.on" @change.prevent="toggleModule(m.key)" :disabled="settings.saving" :aria-label="m.label" :data-module="m.key">
                          <span class="pn-switch-track" aria-hidden="true"></span>
                        </label>
                      </li>
                    </template>
                  </ul>
                </section>

                <div class="flex flex-col gap-5">
                  <section class="card">
                    <div class="card-header"><h3 class="card-title">Kontrol listesi</h3></div>
                    <ul class="divide-y divide-line">
                      <template x-for="c in overview.checks" :key="c.label">
                        <li class="flex items-start gap-3 px-4 py-3">
                          <svg class="icon icon-sm mt-0.5 shrink-0" :class="c.status === 'ok' ? 'text-success' : 'text-warning'" aria-hidden="true"><use :href="c.status === 'ok' ? '#i-check-circle' : '#i-alert-circle'"/></svg>
                          <span class="min-w-0 flex-1 text-sm"><span class="block font-semibold text-ink" x-text="c.label"></span><span class="block text-ink-2" x-text="c.detail"></span></span>
                          <button type="button" class="btn btn-ghost btn-sm" x-show="c.tab && c.status !== 'ok'" @click="show(c.tab)">Düzelt</button>
                        </li>
                      </template>
                    </ul>
                  </section>
                  <section class="card card-body flex flex-col gap-2 text-sm">
                    <p class="font-semibold text-ink">Dosyalar</p>
                    <a :href="overview.urls.sitemap" target="_blank" rel="noopener" class="link-arrow">sitemap.xml <svg class="icon icon-sm" aria-hidden="true"><use href="#i-external"/></svg></a>
                    <a :href="overview.urls.robots" target="_blank" rel="noopener" class="link-arrow">robots.txt <svg class="icon icon-sm" aria-hidden="true"><use href="#i-external"/></svg></a>
                    <a :href="overview.urls.llms" target="_blank" rel="noopener" class="link-arrow" x-show="overview.state.modules.llms">llms.txt <svg class="icon icon-sm" aria-hidden="true"><use href="#i-external"/></svg></a>
                  </section>
                </div>
              </div>
            </div>
          </template>
        </div>
      </template>
    </div>
  </template>

  {# ============================================================ yapay zekâ görünürlüğü (kodmob-core Seo\Services\AiVisibility) #}
  <template x-if="tab === 'ai'">
    <div class="flex flex-col gap-5" data-testid="seo-ai">
      <template x-if="aiLoading"><div class="pn-stats"><span class="skeleton h-28"></span><span class="skeleton h-28"></span><span class="skeleton h-28"></span><span class="skeleton h-28"></span></div></template>
      <template x-if="!aiLoading && ai">
        <div class="flex flex-col gap-5">
          <div class="pn-stats">
            <div class="card pn-stat">
              <span class="pn-stat-label">Yapay zekâ ziyareti</span>
              <span><span class="pn-stat-value" x-text="aiVisits" data-testid="ai-visits"></span><span class="pn-stat-sub" x-text="'son ' + ai.days + ' gün · eğitim, arama, kullanıcı isteği'"></span></span>
            </div>
            <div class="card pn-stat">
              <span class="pn-stat-label">Soru üzerine okuma</span>
              <span><span class="pn-stat-value" x-text="ai.totals.user"></span><span class="pn-stat-sub">biri sorunca sayfanız o an okundu</span></span>
            </div>
            <div class="card pn-stat">
              <span class="pn-stat-label">Arama motorları</span>
              <span><span class="pn-stat-value" x-text="ai.totals.engine"></span><span class="pn-stat-sub">Google, Bing, Apple (yapay zekâ özetleri de)</span></span>
            </div>
            <button type="button" class="card card-hover pn-stat text-left" @click="$refs.aiContent?.scrollIntoView({ behavior: 'smooth' })">
              <span class="pn-stat-label">İçerik hazırlığı</span>
              <span><span class="pn-stat-value" :class="ai.score >= 80 ? 'text-success-ink' : ai.score >= 50 ? 'text-warning-ink' : 'text-danger'" x-text="ai.score ?? '—'"></span><span class="pn-stat-sub" x-text="ai.content.length + ' sayfa · yapay zekâ cevabına uygunluk'"></span></span>
            </button>
          </div>

          <div class="grid items-start gap-5 xl:grid-cols-[1fr_24rem]">
            <section class="card pn-group-card">
              <div class="flex flex-wrap items-baseline justify-between gap-2">
                <h3 class="pn-group-title">Günlük ziyaret</h3>
                <span class="text-xs text-muted" x-text="fmt.date(ai.since) + ' – bugün'"></span>
              </div>
              <div class="flex h-28 items-end gap-0.5" role="img" :aria-label="'Son ' + ai.days + ' günde ' + aiVisits + ' yapay zekâ ziyareti'">
                <template x-for="d in ai.daily" :key="d.day">
                  <span class="min-h-0.5 flex-1 rounded-t bg-primary/70 transition-colors hover:bg-primary" :style="{ height: aiBar(d) + '%' }" :title="aiDayTitle(d)"></span>
                </template>
              </div>
              <p class="text-xs text-muted">Kayıt 2.4 sürümüyle başladı; botlar geldikçe dolar. Arama motorları dahil.</p>
            </section>

            <section class="card">
              <div class="card-header"><h3 class="card-title">Denetim</h3></div>
              <ul class="divide-y divide-line">
                <template x-for="c in ai.checks" :key="c.key">
                  <li class="flex items-start gap-3 px-4 py-3" :data-check="c.key">
                    <svg class="icon icon-sm mt-0.5 shrink-0" :class="{ ok: 'text-success', warning: 'text-warning', bad: 'text-danger', info: 'text-muted' }[c.status]" aria-hidden="true"><use :href="{ ok: '#i-check-circle', warning: '#i-alert-circle', bad: '#i-alert-circle', info: '#i-info' }[c.status]"/></svg>
                    <span class="min-w-0 flex-1 text-sm"><span class="block font-semibold text-ink" x-text="c.label"></span><span class="block text-ink-2" x-text="c.detail"></span></span>
                    <button type="button" class="btn btn-ghost btn-sm" x-show="c.tab && c.status !== 'ok' && c.status !== 'info'" @click="show(c.tab)">Düzelt</button>
                  </li>
                </template>
              </ul>
            </section>
          </div>

          <section class="card">
            <div class="card-header">
              <h3 class="card-title">Yapay zekâ botları</h3>
              <button type="button" class="btn btn-ghost btn-sm" @click="show('robots')">Robots kuralları</button>
            </div>
            <div class="pn-table-wrap">
              <table class="pn-table" data-testid="ai-bots">
                <thead><tr><th scope="col">Bot</th><th scope="col">Ne için</th><th scope="col" class="text-right">Ziyaret</th><th scope="col" class="text-right">Sayfa</th><th scope="col">Son ziyaret</th><th scope="col">robots.txt</th></tr></thead>
                <tbody>
                  <template x-for="b in aiVisibleRows" :key="b.name">
                    <tr :class="!b.hits && 'text-muted'" :data-bot="b.name">
                      <th scope="row"><span class="block font-semibold" :class="b.hits ? 'text-ink' : 'text-ink-2'" x-text="b.product"></span><span class="block text-xs text-muted" x-text="b.company + ' · ' + b.name"></span></th>
                      <td><span class="badge" :class="{ training: 'badge-neutral', search: 'badge-primary', user: 'badge-success', engine: 'badge-info' }[b.purpose]" x-text="b.purpose_label"></span></td>
                      <td class="text-right tabular-nums" x-text="b.hits"></td>
                      <td class="text-right tabular-nums" x-text="b.pages"></td>
                      <td x-text="b.last_at ? fmt.relative(b.last_at) : '—'"></td>
                      <td><span class="badge" :class="b.blocked ? 'badge-danger' : 'badge-success'" x-text="b.blocked ? 'Engelli' : 'İzinli'"></span></td>
                    </tr>
                  </template>
                </tbody>
              </table>
            </div>
            <div class="px-4 pt-3" x-show="aiRows.some((b) => b.hits) && aiRows.some((b) => !b.hits)">
              <button type="button" class="btn btn-ghost btn-sm" @click="aiShowAll = !aiShowAll" x-text="aiShowAll ? 'Yalnızca gelen botlar' : 'Gelmeyen botları da göster (' + aiRows.filter((b) => !b.hits).length + ')'" data-testid="ai-show-all"></button>
            </div>
            <p class="px-4 pb-4 text-xs text-muted">Eğitim: modeli eğitmek için toplar. Yapay zekâ araması: cevaplarda kaynak gösterilecek dizin. Kullanıcı isteği: biri soru sorunca sayfa o an okunur. Google'ın Gemini'si ve yapay zekâ özetleri Googlebot'la gelir.</p>
          </section>

          <section class="card" x-show="ai.pages.length">
            <div class="card-header"><h3 class="card-title">Yapay zekânın en çok okuduğu sayfalar</h3></div>
            <ul class="divide-y divide-line">
              <template x-for="p in ai.pages" :key="p.path">
                <li class="flex flex-wrap items-center gap-x-3 gap-y-1 px-4 py-2.5 text-sm">
                  <a :href="p.path" target="_blank" rel="noopener" class="code min-w-0 flex-1 truncate text-primary hover:underline" x-text="p.path"></a>
                  <span class="text-xs text-muted" x-text="p.bots.join(', ')"></span>
                  <span class="w-12 text-right font-semibold tabular-nums text-ink" x-text="p.hits"></span>
                </li>
              </template>
            </ul>
          </section>

          <section class="card" x-ref="aiContent">
            <div class="card-header"><h3 class="card-title">İçeriğin yapay zekâ cevabına hazırlığı</h3></div>
            <template x-if="!ai.content.length"><p class="px-4 pb-4 text-sm text-ink-2">Yayında içerik yok ya da SEO kapalı.</p></template>
            <ul class="divide-y divide-line" x-show="ai.content.length" data-testid="ai-content">
              <template x-for="c in ai.content.slice(0, 30)" :key="c.key">
                <li class="flex items-start gap-3 px-4 py-3">
                  <span class="badge shrink-0 tabular-nums" :class="{ good: 'badge-success', ok: 'badge-warning', bad: 'badge-danger' }[c.grade]" x-text="c.score"></span>
                  <span class="min-w-0 flex-1 text-sm">
                    <span class="block font-semibold text-ink"><span x-text="c.title"></span> <span class="ml-1 text-xs font-normal text-muted" x-text="c.type_label + ' · ' + (localeLabels[c.locale] || c.locale)"></span></span>
                    <template x-for="m in c.missing" :key="m"><span class="block text-ink-2" x-text="'• ' + m"></span></template>
                    <span class="block text-success-ink" x-show="!c.missing.length">Hazır.</span>
                  </span>
                  <a :href="c.edit" class="btn btn-ghost btn-sm shrink-0">Düzenle</a>
                </li>
              </template>
            </ul>
            <p class="px-4 pb-4 text-xs text-muted" x-show="ai.content.length > 30" x-text="'En düşük puanlı 30 sayfa gösteriliyor (toplam ' + ai.content.length + ').'"></p>
          </section>
        </div>
      </template>
    </div>
  </template>

  {# ============================================================ içerik #}
  <template x-if="tab === 'content'">
    <div class="flex flex-col gap-3">
      <p class="pn-hint"><svg class="icon icon-sm" aria-hidden="true"><use href="#i-info"/></svg><span>Yayındaki her proje ve yazı, dil başına. SEO başlığı, açıklaması ve odak kelimesi düzenleyicideki <b>SEO</b> kutusundan girilir; puan yazarken güncellenir.</span></p>
      <div x-data="kmGrid(contentGrid)" @grid-action="onContent($event.detail)">
        {% include "ui/grid/grid.html" %}
      </div>
    </div>
  </template>

  {# ============================================================ sayfalar #}
  <template x-if="tab === 'pages'">
    <div class="flex flex-col gap-3">
      <p class="pn-hint"><svg class="icon icon-sm" aria-hidden="true"><use href="#i-info"/></svg><span>Sabit sayfaların arama sonucunda görünen başlık ve açıklaması. Boş bırakılan alan sözlükteki varsayılanı kullanır.</span></p>
      <div x-data="kmGrid(pagesGrid)" @grid-open="editPage($event.detail.row)">
        {% include "ui/grid/grid.html" %}
      </div>
    </div>
  </template>

  {# ============================================================ yönlendirmeler #}
  <template x-if="tab === 'redirects'">
    <div class="flex flex-col gap-4">
      <div class="flex flex-wrap items-center gap-2">
        <button type="button" class="btn btn-primary" @click="newRedirect()" data-testid="redirect-new"><svg class="icon icon-sm" aria-hidden="true"><use href="#i-plus"/></svg> Yeni yönlendirme</button>
        <label class="btn btn-secondary" :class="importing && 'pointer-events-none opacity-60'">
          <svg class="icon icon-sm" aria-hidden="true"><use href="#i-upload"/></svg> CSV içe aktar
          <input type="file" accept=".csv,text/csv" class="sr-only" @change="importRedirects($event.target.files); $event.target.value = ''">
        </label>
        <form class="ml-auto flex min-w-0 flex-1 gap-2 sm:max-w-md" @submit.prevent="test()">
          <input class="input code min-h-11" x-model="tester.url" placeholder="Adresi dene: /eski-sayfa" aria-label="Denenecek adres">
          <button type="submit" class="btn btn-secondary">Dene</button>
        </form>
      </div>
      <template x-if="tester.result">
        <p class="rounded-control border border-line bg-surface-subtle px-3 py-2 text-sm" role="status">
          <span x-show="!tester.result.rule">Bu adres hiçbir kurala uymuyor.</span>
          <span x-show="tester.result.rule"><b class="code" x-text="tester.url"></b> → <b class="code" x-text="tester.result.location || '410 (kaldırıldı)'"></b> <span class="badge badge-primary ml-1" x-text="tester.result.code"></span></span>
        </p>
      </template>
      <div x-data="kmGrid(redirectGrid)" @grid-open="editRedirect($event.detail.row)" @grid-action="onRedirect($event.detail)" @grid-bulk="onRedirect($event.detail)">
        {% include "ui/grid/grid.html" %}
      </div>
      <p class="text-xs text-muted">CSV sütunları: kaynak; hedef; kod (301/302/307/410); regex (0/1); aktif (0/1); not. Düzenli ifadeler ayraçsız yazılır, ör. <span class="code">^/blog/(\d+)/(.+)$</span> → <span class="code">/blog/$2/</span>.</p>
    </div>
  </template>

  {# ============================================================ 404 #}
  <template x-if="tab === '404'">
    <div class="flex flex-col gap-3">
      <section class="card overflow-hidden" data-testid="seo-links">
        <header class="flex flex-wrap items-center gap-3 border-b border-line px-5 py-4">
          <div class="min-w-0 flex-1">
            <h3 class="font-semibold text-ink">İçerikteki iç bağlantılar</h3>
            <p class="text-sm text-muted" x-text="links.checked_at ? 'Son denetim ' + fmt.relative(links.checked_at) + ' · her gece kendiliğinden' : 'Henüz denetlenmedi'"></p>
          </div>
          <button type="button" class="btn btn-primary btn-sm" x-show="movedLinks" @click="fixLinks()" :disabled="links.loading" data-testid="seo-links-fix">
            <svg class="icon icon-sm" aria-hidden="true"><use href="#i-check"/></svg> <span x-text="'Yönlenenleri güncelle (' + movedLinks + ')'"></span>
          </button>
          <button type="button" class="btn btn-secondary btn-sm" @click="loadLinks(true)" :disabled="links.loading">
            <svg class="icon icon-sm" :class="links.loading && 'animate-spin'" aria-hidden="true"><use :href="links.loading ? '#i-loader' : '#i-refresh'"/></svg> Yeniden denetle
          </button>
        </header>
        <p class="flex items-center gap-2 px-5 py-4 text-sm text-ink-2" x-show="!links.loading && !links.items.length"><svg class="icon icon-sm text-success" aria-hidden="true"><use href="#i-check-circle"/></svg> Yayındaki içerikte kırık ya da yönlenen iç bağlantı yok.</p>
        <ul class="divide-y divide-line" x-show="links.items.length">
          <template x-for="(item, i) in links.items" :key="i">
            <li class="flex flex-wrap items-center gap-x-3 gap-y-1 px-5 py-3 text-sm">
              <span class="badge" :class="LINK_PROBLEMS[item.problem]?.badge" x-text="LINK_PROBLEMS[item.problem]?.label"></span>
              <span class="code min-w-0 truncate" x-text="item.url"></span>
              <span class="text-muted" x-show="item.target" x-text="'→ ' + item.target"></span>
              <a :href="linkSource(item)" class="ml-auto inline-flex min-w-0 items-center gap-1.5 font-medium text-primary hover:underline"><span class="truncate" x-text="item.title"></span> <span class="text-xs text-muted" x-text="item.locale.toUpperCase()"></span> <svg class="icon icon-sm" aria-hidden="true"><use href="#i-pencil"/></svg></a>
            </li>
          </template>
        </ul>
      </section>
      <p class="pn-hint"><svg class="icon icon-sm" aria-hidden="true"><use href="#i-info"/></svg><span>Sitede bulunamayan adresler (dosyalar ve bilinen saldırı denemeleri hariç). "İç bağlantı": ziyaretçi sitenin kendi sayfasından geldi, bağlantıyı düzeltin. "Önerilene yönlendir" benzer adresi hedef yapar; bot taramalarını yoksayabilirsiniz.</span></p>
      <div x-data="kmGrid(notFoundGrid)" @grid-action="onNotFound($event.detail)" @grid-bulk="onNotFound($event.detail)">
        {% include "ui/grid/grid.html" %}
      </div>
    </div>
  </template>

  {# ============================================================ robots ve llms #}
  <template x-if="tab === 'robots'">
    <div class="grid items-start gap-5 xl:grid-cols-2" x-data="{ get values() { return this.settings.values; }, get errors() { return this.settings.errors; } }">
      <section class="card pn-group-card">
        <h3 class="pn-group-title">robots.txt</h3>
        <p class="text-sm text-ink-2" x-show="!robots.indexable">Site yayın öncesi modunda: robots.txt her şeyi engeller. Aşağıdaki kurallar site arama motorlarına açılınca geçerli olur.</p>
        <label class="field">
          <span class="field-label">Ek kurallar</span>
          <textarea class="input code min-h-36 text-sm" x-model="robots.extra" placeholder="Disallow: /teklif-hesapla/" :aria-invalid="!!robots.error" :disabled="!overview?.state?.modules?.robots"></textarea>
          <span class="field-help">Her satır bir kural: User-agent, Allow, Disallow, Crawl-delay, Sitemap. # ile not.</span>
          <span class="field-error" x-show="robots.error" x-text="robots.error"></span>
        </label>
        <div class="pn-grid">
          <template x-for="s in fields(['seo.ai_bots'])" :key="s.key">{% include "pages/panel/_setting-field.njk" %}</template>
        </div>
        <p class="text-xs text-muted" x-text="'Yapay zekâ tarayıcıları: ' + robots.ai_bots.join(', ')"></p>
        <div class="flex gap-2">
          <button type="button" class="btn btn-primary" @click="saveRobots(); changedSettings.includes('seo.ai_bots') && saveSettings(['seo.ai_bots'])" :disabled="robots.saving || !overview?.state?.modules?.robots">Kaydet</button>
        </div>
        <p class="text-sm text-warning-ink" x-show="!overview?.state?.modules?.robots">Robots modülü kapalı: varsayılan robots.txt kullanılıyor.</p>
      </section>
      <div class="flex flex-col gap-5">
        <section class="card pn-group-card">
          <h3 class="pn-group-title">Önizleme</h3>
          <pre class="code max-h-80 overflow-auto rounded-control bg-surface-subtle p-3 text-xs whitespace-pre-wrap text-ink" x-text="robots.preview"></pre>
        </section>
        <section class="card pn-group-card">
          <h3 class="pn-group-title">llms.txt ve site haritası</h3>
          <div class="pn-grid">
            <template x-for="s in fields(['seo.llms_intro', 'seo.sitemap_images'])" :key="s.key">
              {% include "pages/panel/_setting-field.njk" %}
            </template>
          </div>
          <div class="flex flex-wrap gap-2">
            <button type="button" class="btn btn-primary" @click="saveSettings()" :disabled="settings.saving || !changedSettings.length">Kaydet</button>
            <a :href="overview?.urls?.llms" target="_blank" rel="noopener" class="btn btn-ghost" x-show="overview?.state?.modules?.llms">llms.txt</a>
            <a :href="overview?.urls?.llms_full" target="_blank" rel="noopener" class="btn btn-ghost" x-show="overview?.state?.modules?.llms">llms-full.txt</a>
            <a :href="overview?.urls?.sitemap" target="_blank" rel="noopener" class="btn btn-ghost">sitemap.xml</a>
          </div>
        </section>
      </div>
    </div>
  </template>

  {# ============================================================ ayarlar #}
  <template x-if="tab === 'settings'">
    <div class="flex flex-col gap-5" x-data="{ get values() { return this.settings.values; }, get errors() { return this.settings.errors; } }">
      <div class="pn-savebar !static" x-show="changedSettings.length" x-cloak>
        <span class="flex-1 text-sm font-medium text-ink" x-text="changedSettings.length + ' değişiklik'"></span>
        <button type="button" class="btn btn-ghost" @click="loadSettings()">Vazgeç</button>
        <button type="button" class="btn btn-primary" @click="saveSettings()" :disabled="settings.saving" data-testid="seo-settings-save">Kaydet</button>
      </div>

      <section class="card pn-group-card">
        <h3 class="pn-group-title">Sosyal paylaşım</h3>
        <div class="pn-grid">
          <div class="pn-field pn-w-half" data-setting="seo.default_image">
            <span class="field-label">Varsayılan paylaşım görseli</span>
            <div class="flex items-center gap-3">
              <span class="text-sm text-ink-2" x-text="settings.values['seo.default_image'] ? 'Görsel #' + settings.values['seo.default_image'] : 'Seçilmedi'"></span>
              <button type="button" class="btn btn-secondary btn-sm" @click="pickImage('seo.default_image')">Seç</button>
              <button type="button" class="btn btn-ghost btn-sm" x-show="settings.values['seo.default_image']" @click="settings.values['seo.default_image'] = 0">Kaldır</button>
            </div>
            <p class="field-help">Kendi görseli olmayan sayfalar paylaşılınca bu görsel çıkar (1200×630 önerilir).</p>
          </div>
          <template x-for="s in fields(['seo.twitter'])" :key="s.key">{% include "pages/panel/_setting-field.njk" %}</template>
        </div>
      </section>

      <section class="card pn-group-card">
        <h3 class="pn-group-title">Kurum ve yerel işletme şeması</h3>
        <p class="text-sm text-ink-2">Arama motorlarına kurumu anlatır (logo, adres, iletişim, çalışma saatleri, sosyal profiller). E-posta, telefon, açık adres, çalışma saatleri ve sosyal hesaplar Ayarlar > İletişim ve Sosyal medya'dan alınır.</p>
        <div class="pn-grid">
          <div class="pn-field pn-w-half">
            <span class="field-label">Logo</span>
            <div class="flex items-center gap-3">
              <span class="text-sm text-ink-2" x-text="settings.values['seo.org_logo'] ? 'Görsel #' + settings.values['seo.org_logo'] : 'Site simgesi'"></span>
              <button type="button" class="btn btn-secondary btn-sm" @click="pickImage('seo.org_logo')">Seç</button>
              <button type="button" class="btn btn-ghost btn-sm" x-show="settings.values['seo.org_logo']" @click="settings.values['seo.org_logo'] = 0">Kaldır</button>
            </div>
          </div>
          <template x-for="s in fields(['seo.org_type', 'seo.org_name', 'seo.org_city', 'seo.org_region', 'seo.org_postal', 'seo.org_country', 'seo.org_lat', 'seo.org_lng', 'seo.org_founded', 'seo.org_price', 'seo.org_area'])" :key="s.key">{% include "pages/panel/_setting-field.njk" %}</template>
        </div>
      </section>

      <section class="card pn-group-card">
        <h3 class="pn-group-title">Site doğrulama</h3>
        <p class="text-sm text-ink-2">Arama konsollarının verdiği doğrulama etiketinin yalnızca <span class="code">content</span> değerini yapıştırın.</p>
        <div class="pn-grid">
          <template x-for="s in fields(['seo.verify_google', 'seo.verify_bing', 'seo.verify_yandex', 'seo.verify_baidu'])" :key="s.key">{% include "pages/panel/_setting-field.njk" %}</template>
        </div>
      </section>

      <section class="card pn-group-card">
        <h3 class="pn-group-title">Blog içeriği ve 404</h3>
        <div class="pn-grid">
          <template x-for="s in fields(['seo.toc_min', 'seo.links_new_tab', 'seo.links_nofollow', 'seo.retention_404'])" :key="s.key">{% include "pages/panel/_setting-field.njk" %}</template>
        </div>
      </section>

      <section class="card pn-group-card" x-show="overview?.state?.modules?.indexnow">
        <h3 class="pn-group-title">Anında indeksleme (IndexNow)</h3>
        <template x-if="indexnow">
          <div class="flex flex-col gap-3 text-sm">
            <p class="text-ink-2">Yayınlanan ya da güncellenen proje ve yazılar Bing, Yandex ve diğer IndexNow motorlarına kendiliğinden bildirilir. Google IndexNow'u desteklemez; Search Console'u kullanın.</p>
            <dl class="pn-dl"><dt>Anahtar</dt><dd class="code" x-text="indexnow.key"></dd><dt>Durum</dt><dd x-text="indexnow.indexable ? 'Hazır' : 'Site arama motorlarına kapalı; gönderim beklemede'"></dd></dl>
            <div><button type="button" class="btn btn-secondary btn-sm" @click="submitIndexNow()" :disabled="!indexnow.indexable">Bütün sayfaları şimdi bildir</button></div>
            <ul class="divide-y divide-line rounded-control border border-line" x-show="indexnow.history.length">
              <template x-for="h in indexnow.history" :key="h.at + h.status">
                <li class="flex flex-wrap gap-x-3 px-3 py-2 text-xs"><span class="font-medium text-ink" x-text="fmt.dateTime(h.at)"></span><span x-text="h.count + ' adres'"></span><span :class="h.status === 'sent' ? 'text-success-ink' : 'text-warning-ink'" x-text="h.message || h.status"></span></li>
              </template>
            </ul>
          </div>
        </template>
      </section>
    </div>
  </template>

  {# ============================================================ sayfa düzenle #}
  <div class="pn-drawer-backdrop" x-show="pageEdit" x-transition.opacity x-cloak @click="pageEdit = null"></div>
  <aside class="pn-drawer flex flex-col" x-show="pageEdit" x-cloak x-transition:enter="transition duration-200 ease-out" x-transition:enter-start="translate-x-full" x-transition:enter-end="translate-x-0" x-transition:leave="transition duration-150 ease-in" x-transition:leave-start="translate-x-0" x-transition:leave-end="translate-x-full" @keydown.escape.window="pageEdit = null" aria-label="Sayfa SEO'su">
    <template x-if="pageEdit">
      <form class="flex h-full flex-col" @submit.prevent="savePage()">
        <div class="pn-drawer-head">
          <div class="min-w-0 flex-1"><p class="truncate text-lg font-bold text-ink code" x-text="pageEdit.path"></p><p class="text-sm text-muted" x-text="localeLabels[pageEdit.locale] + ' · sabit sayfa'"></p></div>
          <button type="button" class="btn-icon" @click="pageEdit = null" aria-label="Kapat"><svg class="icon" aria-hidden="true"><use href="#i-x"/></svg></button>
        </div>
        <div class="pn-drawer-body flex flex-col gap-4">
          <div class="rounded-control border border-line p-3" aria-label="Arama sonucu önizlemesi">
            <p class="text-xs text-muted" x-text="serp(pageEdit.title || pageEdit.default_title, pageEdit.description || pageEdit.default_description, pageEdit.path).url"></p>
            <p class="text-lg leading-snug text-[#1a0dab] dark:text-[#8ab4f8]" x-text="serp(pageEdit.title || pageEdit.default_title, pageEdit.description || pageEdit.default_description, pageEdit.path).title"></p>
            <p class="text-sm text-ink-2" x-text="serp(pageEdit.title || pageEdit.default_title, pageEdit.description || pageEdit.default_description, pageEdit.path).description"></p>
          </div>
          <label class="field">
            <span class="field-label flex justify-between"><span>Başlık (sekmede görünen tam başlık)</span><span class="text-xs" :class="lengthTone((pageEdit.title || pageEdit.default_title).length, 30, 60)" x-text="(pageEdit.title || pageEdit.default_title).length + ' / 60'"></span></span>
            <input class="input" x-model="pageEdit.title" :placeholder="pageEdit.default_title" maxlength="120">
          </label>
          <label class="field">
            <span class="field-label flex justify-between"><span>Açıklama</span><span class="text-xs" :class="lengthTone((pageEdit.description || pageEdit.default_description).length, 120, 160)" x-text="(pageEdit.description || pageEdit.default_description).length + ' / 160'"></span></span>
            <textarea class="input min-h-24" x-model="pageEdit.description" :placeholder="pageEdit.default_description" maxlength="320"></textarea>
          </label>
          <label class="pn-switch"><input type="checkbox" class="peer sr-only" x-model="pageEdit.noindex"><span class="pn-switch-track" aria-hidden="true"></span><span><span class="field-label block">Arama motorlarından gizle (noindex)</span><span class="field-help">Site haritasından ve llms.txt'den de çıkar.</span></span></label>
          <div class="field">
            <span class="field-label">Paylaşım görseli</span>
            <div class="flex items-center gap-3">
              <template x-if="pageEdit.image"><img :src="pageEdit.image.thumb || pageEdit.image.src" alt="" class="h-14 w-20 rounded-control object-cover"></template>
              <button type="button" class="btn btn-secondary btn-sm" @click="pickPageImage()" x-text="pageEdit.image ? 'Değiştir' : 'Seç'"></button>
              <button type="button" class="btn btn-ghost btn-sm" x-show="pageEdit.image" @click="pageEdit.image = null; pageEdit.image_id = 0">Kaldır</button>
            </div>
            <span class="field-help">Boşsa varsayılan paylaşım görseli.</span>
          </div>
        </div>
        <div class="pn-drawer-foot">
          <button type="submit" class="btn btn-primary" :disabled="pageEdit.saving">Kaydet</button>
          <button type="button" class="btn btn-ghost" @click="pageEdit = null">Vazgeç</button>
          <button type="button" class="btn btn-ghost ml-auto" @click="pageEdit.title = ''; pageEdit.description = ''; pageEdit.noindex = false; pageEdit.image = null; pageEdit.image_id = 0">Varsayılana dön</button>
        </div>
      </form>
    </template>
  </aside>

  {# ============================================================ yönlendirme ekle / düzenle #}
  <div class="pn-drawer-backdrop" x-show="redirect" x-transition.opacity x-cloak @click="redirect = null"></div>
  <aside class="pn-drawer flex flex-col" x-show="redirect" x-cloak x-transition:enter="transition duration-200 ease-out" x-transition:enter-start="translate-x-full" x-transition:enter-end="translate-x-0" x-transition:leave="transition duration-150 ease-in" x-transition:leave-start="translate-x-0" x-transition:leave-end="translate-x-full" @keydown.escape.window="redirect = null" aria-label="Yönlendirme" data-testid="redirect-drawer">
    <template x-if="redirect">
      <form class="flex h-full flex-col" @submit.prevent="saveRedirect()">
        <div class="pn-drawer-head">
          <p class="min-w-0 flex-1 text-lg font-bold text-ink" x-text="redirect.id ? 'Yönlendirmeyi düzenle' : 'Yeni yönlendirme'"></p>
          <button type="button" class="btn-icon" @click="redirect = null" aria-label="Kapat"><svg class="icon" aria-hidden="true"><use href="#i-x"/></svg></button>
        </div>
        <div class="pn-drawer-body flex flex-col gap-4">
          <label class="field">
            <span class="field-label">Kaynak adres <span class="req">*</span></span>
            <input class="input code" x-model="redirect.source" :placeholder="redirect.is_regex ? '^/blog/(\\d+)/(.+)$' : '/eski-sayfa'" required :aria-invalid="!!redirectErrors.source" data-testid="redirect-source">
            <span class="field-help" x-text="redirect.is_regex ? 'Düzenli ifade (ayraçsız). Yakalanan gruplar hedefte $1, $2 olur.' : 'Sitedeki yol; tam adres yazarsanız yolu alınır. Sondaki / önemsiz.'"></span>
            <span class="field-error" x-show="redirectErrors.source" x-text="redirectErrors.source"></span>
          </label>
          <label class="flex items-center gap-2 text-sm"><input type="checkbox" class="h-4.5 w-4.5 accent-primary" x-model="redirect.is_regex"> Düzenli ifade</label>
          <label class="field">
            <span class="field-label">Tür</span>
            <select class="input" x-model.number="redirect.code">
              <option value="301">301 · Kalıcı (adres değişti)</option>
              <option value="302">302 · Geçici</option>
              <option value="307">307 · Geçici (yöntem korunur)</option>
              <option value="410">410 · Kaldırıldı (içerik artık yok)</option>
            </select>
          </label>
          <label class="field" x-show="Number(redirect.code) !== 410">
            <span class="field-label">Hedef <span class="req">*</span></span>
            <input class="input code" x-model="redirect.target" placeholder="/projeler/yeni-adres/" :aria-invalid="!!redirectErrors.target" data-testid="redirect-target">
            <span class="field-help">/ ile başlayan site içi yol ya da tam adres (https://…).</span>
            <span class="field-error" x-show="redirectErrors.target" x-text="redirectErrors.target"></span>
          </label>
          <label class="field"><span class="field-label">Not</span><input class="input" x-model="redirect.note" maxlength="255" placeholder="ör. Eski WordPress adresi"></label>
          <label class="pn-switch"><input type="checkbox" class="peer sr-only" x-model="redirect.active"><span class="pn-switch-track" aria-hidden="true"></span><span class="field-label">Aktif</span></label>
        </div>
        <div class="pn-drawer-foot">
          <button type="submit" class="btn btn-primary" data-testid="redirect-save">Kaydet</button>
          <button type="button" class="btn btn-ghost" @click="redirect = null">Vazgeç</button>
        </div>
      </form>
    </template>
  </aside>
</div>
