{# Güvenlik. Mantık: panel/security.js. Tablolar: ui/grid (kmGrid). #}
<div class="pn-page" x-data="kmSecurity(r)">
  <div class="-mx-1 overflow-x-auto px-1">
    <div class="pn-tabs w-max" role="tablist" aria-label="Güvenlik">
      <template x-for="t in tabs" :key="t.key">
        <button type="button" role="tab" class="pn-tab" :aria-selected="tab === t.key" @click="show(t.key)" :data-tab="t.key">
          <svg class="icon icon-sm" aria-hidden="true"><use :href="'#i-' + t.icon"/></svg> <span x-text="t.label"></span>
        </button>
      </template>
    </div>
  </div>

  {# ============================================================ genel bakış #}
  <template x-if="tab === 'overview'">
    <div class="flex flex-col gap-5">
      <template x-if="loading"><div class="pn-stats"><span class="skeleton h-28"></span><span class="skeleton h-28"></span><span class="skeleton h-28"></span><span class="skeleton h-28"></span></div></template>
      <template x-if="!loading && overview">
        <div class="flex flex-col gap-5">
          {# Güvenlik puanı: denetimin maddelerinden (tamam tam, uyarı yarım puan). #}
          <section class="card card-body flex flex-wrap items-center gap-4" data-testid="security-score" x-show="overview.score !== undefined">
            <span class="grid h-16 w-16 shrink-0 place-items-center rounded-full text-xl font-bold tabular-nums"
              :class="overview.score >= 80 ? 'bg-success-soft text-success-ink' : overview.score >= 50 ? 'bg-warning-soft text-warning-ink' : 'bg-danger-soft text-danger-ink'" x-text="overview.score"></span>
            <span class="min-w-0 flex-1">
              <span class="block font-semibold text-ink">Güvenlik puanı <span class="text-muted">/ 100</span></span>
              <span class="block text-sm text-ink-2">Aşağıdaki denetimden: tamam olan madde tam puan, uyarı yarım. Uyarıları düzelttikçe artar.</span>
            </span>
          </section>
          <div class="pn-stats">
            <button type="button" class="card card-hover pn-stat text-left" @click="show('sessions')">
              <span class="pn-stat-label">Açık oturum</span>
              <span><span class="pn-stat-value" x-text="fmt.number(overview.stats.sessions)"></span><span class="pn-stat-sub" x-text="overview.stats.users + ' aktif kullanıcı'"></span></span>
            </button>
            <button type="button" class="card card-hover pn-stat text-left" @click="show('events')">
              <span class="pn-stat-label">Hatalı giriş (24 sa)</span>
              <span><span class="pn-stat-value" :class="overview.stats.failed_logins > 10 && 'text-warning-ink'" x-text="fmt.number(overview.stats.failed_logins)"></span><span class="pn-stat-sub" x-text="overview.stats.lockouts + ' kilitli giriş'"></span></span>
            </button>
            <button type="button" class="card card-hover pn-stat text-left" @click="show('events')">
              <span class="pn-stat-label">Engellenen istek (24 sa)</span>
              <span><span class="pn-stat-value" x-text="fmt.number(overview.stats.blocked_requests)"></span><span class="pn-stat-sub">saldırı kalıbı ve engelli IP</span></span>
            </button>
            <button type="button" class="card card-hover pn-stat text-left" @click="show('blocks')">
              <span class="pn-stat-label">IP engeli</span>
              <span><span class="pn-stat-value" x-text="fmt.number(overview.stats.ip_blocks)"></span><span class="pn-stat-sub">süresi dolmamış</span></span>
            </button>
          </div>

          <div class="grid items-start gap-5 xl:grid-cols-[minmax(0,1.6fr)_minmax(0,1fr)]">
            <section class="card" data-testid="security-audit">
              <div class="card-header">
                <h3 class="card-title">Denetim</h3>
                <span class="text-sm text-ink-2" x-text="auditCounts.ok + ' tamam · ' + auditCounts.issues + ' öneri'"></span>
              </div>
              <ul class="divide-y divide-line">
                <template x-for="a in overview.audit" :key="a.key">
                  <li class="flex items-start gap-3 px-4 py-3 md:px-5">
                    <span class="badge mt-0.5 shrink-0" :class="audit[a.status].cls"><svg class="icon icon-sm" aria-hidden="true"><use :href="'#i-' + audit[a.status].icon"/></svg><span x-text="audit[a.status].label"></span></span>
                    <span class="min-w-0 flex-1">
                      <span class="block text-sm font-semibold text-ink" x-text="a.label"></span>
                      <span class="block text-sm text-ink-2" x-text="a.detail"></span>
                      <span class="mt-0.5 block text-sm text-primary-ink" x-show="a.fix" x-text="'→ ' + a.fix"></span>
                    </span>
                  </li>
                </template>
              </ul>
            </section>

            <section class="card" data-setting="security.key">
              <div class="card-header"><h3 class="card-title">Oturum imza anahtarı</h3></div>
              <div class="card-body flex flex-col gap-3 text-sm">
                <p class="text-ink-2">Panel oturumları bu anahtarla imzalanır (JWT, HS256). Anahtarın kendisi gösterilmez; parmak izi değişince eski oturumların hepsi geçersizdir.</p>
                <dl class="pn-dl">
                  <dt>Parmak izi</dt><dd class="code" x-text="overview.key.fingerprint"></dd>
                  <dt>Sürüm</dt><dd x-text="overview.key.version"></dd>
                </dl>
                <button type="button" class="btn btn-danger self-start" @click="rotateKey()" data-testid="rotate-key"><svg class="icon icon-sm" aria-hidden="true"><use href="#i-refresh"/></svg> Anahtarı yenile</button>
                <p class="text-xs text-muted">Herkes (siz de) yeniden giriş yapar. Ele geçmiş bir oturumdan şüphelenince kullanın; tek kişi için Kullanıcılar &gt; Oturumlarını kapat yeterlidir.</p>
              </div>
            </section>
          </div>
        </div>
      </template>
    </div>
  </template>

  {# ============================================================ oturumlar #}
  <template x-if="tab === 'sessions'">
    <div class="flex flex-col gap-3">
      <div class="flex flex-wrap items-center gap-3">
        <p class="pn-hint flex-1"><svg class="icon icon-sm" aria-hidden="true"><use href="#i-info"/></svg><span>Bir oturum = bir cihaz. Kapatılan oturum hemen düşer; erişim jetonunun süresi beklenmez.</span></p>
        <button type="button" class="btn btn-secondary" @click="endAll()" :disabled="sessions.length < 2"><svg class="icon icon-sm" aria-hidden="true"><use href="#i-logout"/></svg> Diğer bütün oturumları kapat</button>
      </div>
      <div x-data="kmGrid(sessionGrid)" @grid-action="onSessionGrid($event.detail)" @grid-bulk="onSessionGrid($event.detail)">
        {% include "ui/grid/grid.html" %}
      </div>
    </div>
  </template>

  {# ============================================================ güvenlik kayıtları #}
  <template x-if="tab === 'events'">
    <div x-data="kmGrid(eventGrid)" @grid-action="onEventGrid($event.detail)">
      {% include "ui/grid/grid.html" %}
    </div>
  </template>

  {# ============================================================ IP engelleri #}
  <template x-if="tab === 'blocks'">
    <div class="flex flex-col gap-4">
      <form class="card card-body grid gap-3 sm:grid-cols-[minmax(0,1fr)_minmax(0,1.4fr)_10rem_auto] sm:items-end" @submit.prevent="block()" data-testid="block-form">
        <label class="field">
          <span class="field-label">IP ya da aralık</span>
          <input class="input code" x-model="blockForm.ip" placeholder="203.0.113.7 ya da 203.0.113.0/24" required data-block-ip :aria-invalid="!!blockErrors.ip">
          <span class="field-error" x-show="blockErrors.ip" x-text="blockErrors.ip"></span>
        </label>
        <label class="field">
          <span class="field-label">Neden</span>
          <input class="input" x-model="blockForm.reason" placeholder="ör. Giriş taraması">
        </label>
        <label class="field">
          <span class="field-label">Süre</span>
          <select class="input" x-model="blockForm.hours">
            <option value="">Süresiz</option>
            <option value="1">1 saat</option>
            <option value="24">1 gün</option>
            <option value="168">1 hafta</option>
            <option value="720">30 gün</option>
          </select>
        </label>
        <button type="submit" class="btn btn-danger"><svg class="icon icon-sm" aria-hidden="true"><use href="#i-ban"/></svg> Engelle</button>
      </form>
      <div x-data="kmGrid(blockGrid)" @grid-action="onBlockGrid($event.detail)" @grid-bulk="onBlockGrid($event.detail)">
        {% include "ui/grid/grid.html" %}
      </div>
    </div>
  </template>

  {# ============================================================ kilitli girişler #}
  <template x-if="tab === 'lockouts'">
    <section class="card">
      <div class="card-header">
        <h3 class="card-title">Kilitli girişler</h3>
        <button type="button" class="btn btn-ghost btn-sm" @click="loadLockouts()"><svg class="icon icon-sm" aria-hidden="true"><use href="#i-refresh"/></svg> Yenile</button>
      </div>
      <p class="card-body pb-0 text-sm text-ink-2">Aynı kullanıcı adı ve IP ile art arda hatalı deneme yapılınca giriş kilitlenir; bir IP farklı kullanıcı adlarıyla çok deneme yaparsa o IP'nin bütün girişleri kapanır. Kilit süresi dolunca kendiliğinden açılır.</p>
      <div class="pn-empty" x-show="!lockouts.length"><span class="icon-tile icon-tile-round"><svg class="icon icon-lg" aria-hidden="true"><use href="#i-lock"/></svg></span><p class="font-semibold text-ink">Kilitli giriş yok.</p></div>
      <ul class="mt-3 divide-y divide-line border-t border-line" x-show="lockouts.length">
        <template x-for="l in lockouts" :key="l.kind + l.username + l.ip">
          <li class="flex flex-wrap items-center gap-3 px-4 py-3 md:px-5">
            <span class="badge" :class="l.kind === 'ip' ? 'badge-danger' : 'badge-warning'" x-text="l.kind === 'ip' ? 'IP' : 'Kullanıcı + IP'"></span>
            <span class="min-w-0 flex-1 text-sm">
              <span class="font-semibold text-ink" x-text="l.username || 'Bütün kullanıcı adları'"></span>
              <span class="code text-ink-2" x-text="' · ' + l.ip"></span>
              <span class="block text-xs text-muted" x-text="l.attempts + ' hatalı deneme · ' + minutes(l.available_in) + ' sonra açılır · son deneme ' + fmt.relative(l.last_at_local)"></span>
            </span>
            <button type="button" class="btn btn-secondary btn-sm" @click="unlock(l)">Kilidi aç</button>
          </li>
        </template>
      </ul>
    </section>
  </template>

  {# ============================================================ ayarlar #}
  <template x-if="tab === 'settings'">
    <section class="card pn-group-card" x-data="{ get values() { return this.settings.values; }, get errors() { return this.settings.errors; } }">
      <div class="flex flex-wrap items-center gap-3">
        <h3 class="pn-group-title flex-1">Güvenlik ayarları</h3>
        <button type="button" class="btn btn-ghost text-danger" @click="resetSettings()">Varsayılana dön</button>
        <button type="button" class="btn btn-primary" @click="saveSettings()" :disabled="settings.saving || !changedSettings.length" data-testid="security-settings-save">
          <svg class="icon icon-sm animate-spin" aria-hidden="true" x-show="settings.saving" x-cloak><use href="#i-loader"/></svg>
          <span x-text="changedSettings.length ? 'Kaydet (' + changedSettings.length + ')' : 'Kaydet'"></span>
        </button>
      </div>
      <p class="text-sm text-ink-2">Oturum süreleri yeni girişlerde geçerli olur; açık oturumlar bir sonraki yenilemede yeni süreyi alır. Değişiklikler İşlem Geçmişi'ne yazılır.</p>
      <div class="pn-grid">
        <template x-for="s in settings.items" :key="s.key">
          {% include "pages/panel/_setting-field.njk" %}
        </template>
      </div>
    </section>
  </template>
</div>
