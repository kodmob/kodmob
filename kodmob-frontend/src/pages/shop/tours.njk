{% extends "layouts/base.njk" %}
{% import "macros/ui.njk" as ui %}
{% import "macros/live.njk" as live %}

{#
  Turlar ve etkinlikler (Rezervasyon; vite/commerce-routes.js bookingRoutes): $store.km.tours. Sunucu ilk kopyayı
  HTML'e yazar (ListSsr).
#}
{% block content %}
{% call ui.pageHero(tx('shop.booking.hero.eyebrow'), tx('shop.booking.hero.title'), tx('shop.booking.hero.titleAccent'), tx('shop.booking.hero.lead')) %}{% endcall %}

<section class="container-site pb-20">
  <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3" x-show="$store.km.tours.length">
    <template x-for="(p, i) in $store.km.tours" :key="p.id" data-km-ssr-list="tours" data-km-ssr-route="tour">
      <a :href="p.url" class="card card-hover group flex flex-col overflow-hidden" data-testid="shop-tour">
        <div class="aspect-[4/3] overflow-hidden">
          {{ live.img('p.cover', '(min-width: 1024px) 380px, (min-width: 640px) 50vw, 100vw', 'h-full w-full object-cover', alt='p.title') }}
        </div>
        <div class="card-body flex flex-1 flex-col gap-2">
          <h2 class="h3" x-text="p.title"></h2>
          <p class="text-sm text-ink-2" x-text="p.summary"></p>
          <p class="text-xs text-muted" x-show="p.duration">{{ ui.icon('clock', 'icon icon-sm') }} <span x-text="p.duration"></span></p>
          <p class="mt-auto flex items-baseline gap-2 pt-2"><span class="text-xs text-muted">{{ t('shop.booking.startingAt') }}</span><strong class="text-lg text-ink" x-text="p.booking?.fromText || p.priceAdultText"></strong><span class="text-sm text-muted">{{ t('shop.booking.perPerson') }}</span></p>
        </div>
      </a>
    </template>
  </div>
  <p class="card card-body text-ink-2" x-show="!$store.km.tours.length" x-cloak>{{ tx('shop.booking.empty') }}</p>
</section>
{% endblock %}
