{#
  "Bu proje Kodmob Core ile geliştirildi" rozeti: profillerin site-footer.njk'si alt satırda (telif yazısının yanında)
  içerir. Profil kapatmak isterse site.config.js `builtWith: false`. Metin çatı sözlüğünde (`builtWith.*`).
#}
{% if builtWith %}
<a class="built-with" href="https://github.com/kodmob/kodmob" target="_blank" rel="noopener" data-testid="built-with">
  <span class="built-with-mark" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M7 4v16"/><path d="M17 4l-7.5 8L17 20"/></svg>
  </span>
  <span class="built-with-text">{{ t('builtWith.before') }} <strong>Kodmob Core</strong> {{ t('builtWith.after') }}</span>
</a>
{% endif %}
