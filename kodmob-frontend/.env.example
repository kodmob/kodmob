# Kodmob Frontend — ortam değişkenleri
#   cp .env.example .env
# Frontend ve API aynı origin'de sunulur: site kökü frontend, /api/ Laravel (kodmob-core).
VITE_APP_NAME=Kodmob

# Her ortamda aynı: dev sunucusu /api/… ve /media/…'yı yerel API'ye iletir (vite.config.js, API_PROXY).
VITE_BASE_URL=/api
VITE_API_BASE_PATH=/v1
VITE_AUTH_BASE_PATH=/v1/auth

VITE_DEBUG_MODE=true

# Sitenin tam adresi (canonical, hreflang, sitemap.xml). Dev sunucusunda
# boş bırakılırsa http://localhost:5173 kullanılır.
SITE_URL=
# true: sayfalar arama motorlarına açık (yalnızca canlıda).
SITE_INDEXABLE=false
