{
  "name": "kodmob-frontend",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/build-sites.mjs",
    "build:prod": "vite build --mode production && node scripts/build-sites.mjs --mode production",
    "build:dev": "vite build --mode development && node scripts/build-sites.mjs --mode development",
    "build:sites": "node scripts/build-sites.mjs",
    "preview": "vite preview",
    "deploy:local": "node scripts/deploy-local.mjs",
    "serve:local": "node scripts/serve-local.mjs",
    "release": "node scripts/package-release.mjs",
    "test": "node --import ./tests/profile-hook.mjs --test tests/*.test.mjs src/profiles/*/tests/*.test.mjs",
    "e2e": "node e2e/run.mjs",
    "test:db": "node scripts/test-db.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4.1.18",
    "autoprefixer": "^10.4.23",
    "embedded-postgres": "18.4.0-beta.17",
    "nunjucks": "^3.2.4",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "vite": "^7.2.4"
  },
  "dependencies": {
    "@alpinejs/collapse": "^3.15.3",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extension-placeholder": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "alpinejs": "^3.15.3",
    "qrcode-generator": "2.0.4"
  }
}
